<forum>
    <!-- Site Settings -->
    <settings>   
      <setting key="EthiopicalVersion" value="1.0" />      
      <setting key="EditorType" value="tinymceeditor"/>          
      <!--Social Login Credentials-->
      <setting key="FacebookAppId" value="1334630715289084" />
      <setting key="FacebookAppSecret" value="33c5bf371e677229add6ff93e6700344" />
   <setting key="GooglePlusAppId" value="30265407192-btpimlemb7m6ok8sq4dguj79dr6esbna.apps.googleusercontent.com"/>
      <setting key="GooglePlusAppSecret" value="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"/>
 <!---   <setting key="GooglePlusAppId" value="106240599227-0pa2hp9gim1ktbfe9rcaa1h3hcncl08u.apps.googleusercontent.com"/>
      <setting key="GooglePlusAppSecret" value="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"/>-->
      <setting key="MicrosoftAppId" value="b64971ca-d66c-4fdb-92b9-af9fdf27187f" />
      <setting key="MicrosoftAppSecret" value="7vZ8Q~xgXTNVDEX4kgWFxHv21vHqn7xVe0efVaFO" />
      <!--Registration -->
      <setting key="AutoLoginAfterRegister" value="True" />
      <!--Avatar sizes-->
      <setting key="GravatarPostSize" value="50" />
      <setting key="GravatarTopicSize" value="50" />
      <setting key="GravatarProfileSize" value="85" />
      <setting key="GravatarLeaderboardSize" value="20" />
      <setting key="GravatarLikedBySize" value="20" />
      <setting key="GravatarFooterSize" value="30" />
      <setting key="GravatarLatestBySize" value="15" />
      <!--Paging Sizes-->
      <setting key="PagingGroupSize" value="10" />
      <setting key="AdminListPageSize" value="100" />
      <setting key="ActiveTopicsListSize" value="100" />
      <setting key="SearchListSize" value="50" />
      <setting key="PrivateMessageListSize" value="30" />
      <setting key="SimilarTopicsListSize" value="6" />
      <setting key="BottomAdsListSize" value="3"/>
      <setting key="TopicsAsideListSize" value="5" />
      <setting key="ChatMessagesListSize" value="10" />
      <setting key="ActivitiesListSize" value="50" />
      <setting key="MembersActivityListSize" value="100" />
      <setting key="AdSlideListSize" value="100" />
      <setting key="AdListSize" value="100" />
      <!--Post Settings-->
      <setting key="IncludeFullPostInEmailNotifications" value="True" />

      <!--Files-->
      <setting key="FileUploadAllowedExtensions" value="jpg,jpeg,png,gif,pdf,mp4,mpeg,txt" />
      <setting key="FileUploadMaximumFileSizeInBytes" value="5242880" />
     <!---<setting key="FileUploadMaximumFileSizeInBytes" value="1073741824" />-->
      <setting key="UploadFolderPath" value="~/content/uploads/" />           
      <!--Banned Words-->
      <setting key="BannedWordReplaceCharactor" value="?" />
      <!--Post Flood Control-->
      <setting key="PostSecondsWaitBeforeNewPost" value="10" />
      <!--Points For Invitation-->
      <setting key="PointsForInvitation" value="1" /> 
      <!--Urls-->
      <setting key="CategoryUrlIdentifier" value="cat" />
      <setting key="TopicUrlIdentifier" value="thread" />
      <setting key="TagsUrlIdentifier" value="tagged" />
      <setting key="MemberUrlIdentifier" value="profile" />  
      <!---Chat-->       
      <setting key="RoomUrlIdentifier" value="lobby"/>
      <setting key="AdUrlIdentifier" value="advert" />
      <!--Misc-->
      <!---<setting key="LogFileMaxSizeBytes" value="1000000" />-->
      <setting key="LogFileMaxSizeBytes" value="100" />
      <setting key="PrivateMessageWarningAmountLessThanAllowedSize" value="2" />
      <!--Roles-->
      <setting key="StandardMembers" value="Standard Members" />     
      <!---Duration-->
      <setting key="ReportMaxWaitingDays" value="90" />
    <!---  <setting key="MonthDays" value="30" /> -->   
      <!---Report -->
     <!--- <setting key="ReportCountToSpam" value="30" />-->
      <setting key="ReportCountToDisable" value="2" />
      <setting key="SpamCountToBan" value="30" />
      <setting key="ReportCountsToFlaggedAsSpam" value="3" />
      <setting key="PointsForReport" value="1" />
      
      <!--
     Category Permissions
      ///  These are the permission names used as keys to return them
      ///  So they must be the same as the database value - DO NOT change the core permissions names
      ///  or your forum is likely to stop working
    -->
      <setting key="PermissionReadOnly" value="Read Only" />
      <setting key="PermissionDeletePosts" value="Delete Posts" />
      <setting key="PermissionEditPosts" value="Edit Posts" />
      <setting key="PermissionCreateStickyTopics" value="Sticky Topics" />
      <setting key="PermissionDenyAccess" value="Deny Access" />
      <setting key="PermissionLockTopics" value="Lock Topics" />
      <setting key="PermissionVoteInPolls" value="Vote In Polls" />
      <setting key="PermissionCreatePolls" value="Create Polls" />
      <setting key="PermissionCreateTopics" value="Create Topics" />
      <setting key="PermissionAttachFiles" value="Attach Files" />
      <!-- Global Permissions -->
      <setting key="PermissionEditMembers" value="Edit Members" />
      <setting key="PermissionInsertEditorImages" value="Insert Editor Images" />
      <!-- Themes -->
      <setting key="ThemeRootFolder" value="~/Content/Themes/" />
      <!---<setting key="ThemeRootFolder" value="~/Themes/" />-->
      <setting key="ThemeRootFolderName" value="Themes" />
      <!-- Database Context -->
      <setting key="EthioNegaritContext" value="EthioNegaritContext" />
    </settings>   
    <!-- Emoticon replace icons, emoticons are stored in /Content/Images/emoticons -->
    <emoticons>
      <emoticon symbol=":D" image="big-smile-emoticon-for-facebook.png" />
      <emoticon symbol=":O" image="surprised-emoticon.png" />
      <emoticon symbol=":/" image="unsure-emoticon.png" />
      <emoticon symbol=":P" image="facebook-tongue-out-emoticon.png" />
      <emoticon symbol=":)" image="facebook-smiley-face-for-comments.png" />
      <emoticon symbol=":(" image="facebook-frown-emoticon.png" />
      <emoticon symbol=":'(" image="facebook-cry-emoticon-crying-symbol.png" />
      <emoticon symbol="O:)" image="angel-emoticon.png" />
      <emoticon symbol="3:)" image="devil-emoticon.png" />
      <emoticon symbol="-_-" image="squinting-emoticon.png" />
      <emoticon symbol=":*" image="kiss-emoticon.png" />
      <emoticon symbol="^_^" image="kiki-emoticon.png" />
      <emoticon symbol=":v" image="pacman-emoticon.png" />
      <emoticon symbol=":3" image="curly-lips-emoticon.png" />
      <emoticon symbol="o.O" image="confused-emoticon-wtf-symbol-for-facebook.png" />
      <emoticon symbol=";)" image="wink-emoticon.png" />
      <emoticon symbol="8-)" image="glasses-emoticon.png" />
      <emoticon symbol="8| B|" image="sunglasses-emoticon.png" />
    </emoticons>

    <types>
      <type name="StorageProviderType" value="EthioNegarit.WebUI.Application.StorageProviders.DiskStorageProvider" />
    </types>
 </forum>
