@using EthioNegarit.WebUI.ViewModels
@model ChatModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Model.ChatRoom != null ? Model.ChatRoom.Name : "Chat";
    var canChat = User.Identity.IsAuthenticated;
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <section class="col-sm-9">

                <div class="chat-header">
                    <h3 id="roomName">@(Model.ChatRoom != null ? Model.ChatRoom.Name : "")</h3>
                    <span id="onlineCount" class="chat-online">0 online</span>
                </div>

                <div class="chat-panel" id="messages">
                    <ul class="contents-list" id="chatmessages"></ul>
                    <div class="empty" id="emptyState">No messages yet. Be the first to say something.</div>
                </div>

                <div class="footer-fixed">
                    <div id="input-bar">
                        @if (canChat)
                        {
                            <div id="input-wrap">
                                <textarea id="messageInput" rows="1"
                                          placeholder="Type a message… (Enter to send, Shift+Enter for newline)"
                                          maxlength="2000" autocomplete="off"></textarea>
                                <button id="sendButton" type="button" disabled>Send</button>
                            </div>
                        }
                        else
                        {
                            <div class="chat-signin">Please sign in to join the conversation.</div>
                        }
                        <div id="status">Connecting…</div>
                    </div>
                </div>

            </section>
        </div>
    </div>
</section>

<!-- SignalR client + the autogenerated hub proxy (jQuery is loaded by _Layout). -->
<script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
<script src="~/signalr/hubs"></script>
<script type="text/javascript">
    $(function () {

        var roomId   = '@(Model.ChatRoom != null ? Model.ChatRoom.Id.ToString() : "")';
        var canChat  = @(canChat ? "true" : "false");

        var $scroller = $('#messages');
        var $list     = $('#chatmessages');
        var $empty    = $('#emptyState');
        var $input    = $('#messageInput');
        var $send     = $('#sendButton');
        var $status   = $('#status');
        var $online   = $('#onlineCount');
        var lastSender = null;

        var chat = $.connection.chatHub;

        // ── Server → client callbacks (names match the hub) ──────────────────
        chat.client.loadHistory = function (list) {
            $list.empty();
            lastSender = null;
            (list || []).forEach(function (m) { appendMessage(m); });
            toggleEmpty();
            scrollToBottom();
        };

        chat.client.roomJoined = function (id, name, count) {
            if (name) { $('#roomName').text(name); }
            setOnline(count);
            $status.text('Connected').css('color', 'green');
        };

        chat.client.receiveMessage = function (m) {
            var stick = isNearBottom();
            appendMessage(m);
            toggleEmpty();
            if (stick) { scrollToBottom(); }
        };

        chat.client.userJoined = function (name, count) { setOnline(count); };
        chat.client.userLeft   = function (name, count) { setOnline(count); };

        chat.client.messageStarred = function (id, count, starred) {
            var $btn = $('#msg-' + id + ' .star-btn');
            $btn.toggleClass('starred', !!starred);
            $btn.find('.star-count').text(count > 0 ? count : '');
        };

        chat.client.messageDeleted = function (id) {
            $('#msg-' + id + ' .chat-text').html('<em class="deleted">message deleted</em>');
            $('#msg-' + id + ' .star-btn').remove();
        };

        chat.client.error = function (text) {
            $status.text(text || 'Something went wrong.').css('color', 'red');
        };

        // ── Start connection, then join the room ─────────────────────────────
        $.connection.hub.start()
            .done(function () {
                chat.server.joinRoom(roomId)
                    .fail(function (e) { console.error('joinRoom failed:', e); });
                if (canChat) { $send.prop('disabled', $.trim($input.val()).length === 0); $input.focus(); }
            })
            .fail(function (err) {
                $status.text('Could not connect. Refresh to retry.').css('color', 'red');
                console.error('SignalR start failed:', err);
            });

        // ── Sending ──────────────────────────────────────────────────────────
        function sendMessage() {
            if (!canChat) { return; }
            var content = $.trim($input.val());
            if (!content) { return; }
            if ($.connection.hub.state !== $.signalR.connectionState.connected) {
                $status.text('Not connected yet — try again in a moment.');
                return;
            }
            chat.server.sendMessage(roomId, content)
                .fail(function (e) { console.error('sendMessage failed:', e); });
            $input.val('').css('height', 'auto');
            $send.prop('disabled', true);
            $input.focus();
        }

        if (canChat) {
            $send.on('click', sendMessage);
            $input.on('keypress', function (e) {
                if (e.which === 13 && !e.shiftKey) { e.preventDefault(); sendMessage(); }
            }).on('input', function () {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 120) + 'px';
                $send.prop('disabled', $.trim(this.value).length === 0);
            });
        }

        // Star toggle (event-delegated, survives re-render).
        $list.on('click', '.star-btn', function () {
            var id = $(this).closest('.msg-row').attr('id').replace('msg-', '');
            chat.server.toggleStar(id).fail(function (e) { console.error('toggleStar failed:', e); });
        });

        // ── Rendering ─────────────────────────────────────────────────────────
        function escapeHtml(s) { return $('<div/>').text(s == null ? '' : s).html(); }
        function formatText(s) { return escapeHtml(s).replace(/\n/g, '<br>'); }
        function formatTime(iso) { var d = new Date(iso); return isNaN(d.getTime()) ? '' : d.toLocaleString(); }

        function appendMessage(m) {
            var author = m.authorName || 'Unknown';
            var isSame = (lastSender === author);
            lastSender = author;

            var avatar = !isSame
                ? '<div class="chat-img"><img src="https://www.gravatar.com/avatar/' +
                      (m.gravatarHash || '') + '?s=64&d=identicon" alt="" /></div>'
                : '<div class="chat-img" style="width:32px;flex-shrink:0;"></div>';

            var meta = !isSame
                ? '<div class="chat-meta"><span class="chat-user">' + escapeHtml(author) +
                      '</span> <span class="chat-time">' + formatTime(m.sentAt) + '</span></div>'
                : '';

            var replyTo = m.parentPreview
                ? '<div class="chat-reply">↪ ' + escapeHtml(m.parentAuthor || '') + ': ' + escapeHtml(m.parentPreview) + '</div>'
                : '';

            var text = '<div class="chat-text">' + replyTo + formatText(m.content) + '</div>';

            var starred = m.isStarred ? ' starred' : '';
            var starNum = (m.starCount && m.starCount > 0) ? m.starCount : '';
            var actions = '<div class="chat-social">' +
                '<button type="button" class="action-btn star-btn' + starred + '" title="Star">' +
                  '★ <span class="star-count">' + starNum + '</span>' +
                '</button></div>';

            $list.append(
                '<li class="msg-row" id="msg-' + m.id + '">' +
                    avatar +
                    '<div class="msg-content">' + meta + text + '</div>' +
                    actions +
                '</li>'
            );
        }

        function setOnline(count) {
            var n = (typeof count === 'number') ? count : 0;
            $online.text(n + (n === 1 ? ' online' : ' online'));
        }
        function toggleEmpty() { $empty.toggle($list.children().length === 0); }
        function isNearBottom() {
            var el = $scroller[0];
            return el.scrollHeight - el.scrollTop - el.clientHeight < 60;
        }
        function scrollToBottom() { $scroller.scrollTop($scroller[0].scrollHeight); }
    });
</script>
