
@{
    Layout = "~/Views/Shared/_LayoutFullWidth.cshtml";
    ViewBag.Title = "Chat Room";
    }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Stack Chat – Real-Time Chat Rooms</title>
    <!-- SignalR & jQuery -->
   @* <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
    <script src="~/signalr/hubs"></script>*@

   
    <script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
    <!-- Reference the autogenerated SignalR hub script. -->
    <script src="~/signalr/hubs"></script>
    <style>
        /* ── Reset & Base ─────────────────────────────────────────────────── */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg-page: #1a1a1b;
            --bg-sidebar: #242526;
            --bg-main: #1e1e1f;
            --bg-input: #2d2d2e;
            --bg-message: #2a2a2b;
            --bg-hover: #333334;
            --accent: #f48024;
            --accent-dim: #c06010;
            --blue: #0074cc;
            --blue-light: #379fef;
            --text-primary: #e8e6e3;
            --text-muted: #9b9b9b;
            --text-dim: #6a6a6a;
            --border: #3d3d3e;
            --star: #f4c430;
            --green: #2ecc71;
            --red: #e74c3c;
            --radius: 4px;
            --font-mono: 'Consolas', 'Courier New', monospace;
            --font-ui: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        html, body {
            height: 100%;
            overflow: hidden;
            background: var(--bg-page);
            color: var(--text-primary);
            font-family: var(--font-ui);
            font-size: 13px;
        }

        /* ── Layout ───────────────────────────────────────────────────────── */
        #app {
            display: flex;
            height: 100vh;
        }

        /* ── Left Sidebar — Room List ─────────────────────────────────────── */
        #sidebar {
            width: 220px;
            min-width: 220px;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        #sidebar-header {
            padding: 14px 12px 10px;
            border-bottom: 1px solid var(--border);
        }

            #sidebar-header .brand {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 15px;
                font-weight: 700;
                color: var(--text-primary);
            }

                #sidebar-header .brand .logo {
                    width: 24px;
                    height: 24px;
                    background: var(--accent);
                    border-radius: 3px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-weight: 900;
                    font-size: 11px;
                    color: #fff;
                    letter-spacing: -1px;
                }

        #rooms-label {
            padding: 12px 12px 6px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--text-dim);
        }

        #room-list {
            flex: 1;
            overflow-y: auto;
            padding-bottom: 8px;
        }

        .room-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 7px 12px;
            cursor: pointer;
            border-left: 3px solid transparent;
            transition: background .12s, border-color .12s;
        }

            .room-item:hover {
                background: var(--bg-hover);
            }

            .room-item.active {
                background: var(--bg-hover);
                border-left-color: var(--accent);
            }

            .room-item .room-icon {
                width: 28px;
                height: 28px;
                border-radius: 50%;
                background: var(--bg-input);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 11px;
                font-weight: 700;
                color: var(--accent);
                flex-shrink: 0;
            }

            .room-item .room-meta {
                overflow: hidden;
            }

            .room-item .room-name {
                font-weight: 600;
                color: var(--text-primary);
                truncate;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .room-item .room-count {
                font-size: 11px;
                color: var(--text-dim);
            }

        #create-room-btn {
            margin: 8px 12px;
            padding: 7px 10px;
            background: transparent;
            border: 1px dashed var(--border);
            border-radius: var(--radius);
            color: var(--text-muted);
            cursor: pointer;
            font-size: 12px;
            text-align: left;
            transition: border-color .15s, color .15s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            #create-room-btn:hover {
                border-color: var(--accent);
                color: var(--accent);
            }

        /* ── Center — Chat Area ───────────────────────────────────────────── */
        #chat-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        #chat-header {
            padding: 10px 16px;
            background: var(--bg-sidebar);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 10px;
        }

            #chat-header .room-title {
                font-size: 15px;
                font-weight: 700;
            }

            #chat-header .room-desc {
                font-size: 12px;
                color: var(--text-muted);
                margin-left: auto;
            }

        #online-badge {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 11px;
            color: var(--green);
        }

            #online-badge::before {
                content: '';
                width: 6px;
                height: 6px;
                background: var(--green);
                border-radius: 50%;
                display: inline-block;
            }

        /* Messages */
        #messages-wrap {
            flex: 1;
            overflow-y: auto;
            padding: 8px 0;
            scroll-behavior: smooth;
        }

        .day-separator {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 14px 16px;
            font-size: 11px;
            color: var(--text-dim);
        }

            .day-separator::before, .day-separator::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--border);
            }

        .msg-group {
            padding: 4px 0;
        }

            .msg-group:hover {
                background: rgba(255,255,255,.02);
            }

        .msg-row {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 3px 16px;
            position: relative;
        }

            .msg-row:hover .msg-actions {
                opacity: 1;
            }

        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            flex-shrink: 0;
            margin-top: 2px;
            background: var(--bg-input);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 12px;
            color: var(--accent);
            overflow: hidden;
        }

            .avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .msg-content {
            flex: 1;
            min-width: 0;
        }

        .msg-meta {
            display: flex;
            align-items: baseline;
            gap: 8px;
            margin-bottom: 2px;
        }

        .msg-username {
            font-weight: 700;
            color: var(--blue-light);
            font-size: 12px;
            cursor: pointer;
        }

            .msg-username:hover {
                text-decoration: underline;
            }

        .msg-time {
            font-size: 10px;
            color: var(--text-dim);
        }

        .msg-text {
            color: var(--text-primary);
            line-height: 1.5;
            word-break: break-word;
        }

            .msg-text code {
                background: var(--bg-input);
                padding: 1px 5px;
                border-radius: 3px;
                font-family: var(--font-mono);
                font-size: 12px;
                color: #d19a66;
            }

        /* Star badge */
        .star-badge {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            font-size: 11px;
            color: var(--star);
            margin-top: 3px;
        }

        /* Hover actions */
        .msg-actions {
            position: absolute;
            right: 16px;
            top: 4px;
            display: flex;
            gap: 4px;
            opacity: 0;
            transition: opacity .12s;
        }

        .action-btn {
            padding: 3px 7px;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            background: var(--bg-sidebar);
            color: var(--text-muted);
            cursor: pointer;
            font-size: 11px;
            transition: border-color .12s, color .12s;
        }

            .action-btn:hover {
                border-color: var(--accent);
                color: var(--accent);
            }

        /* System messages */
        .sys-msg {
            text-align: center;
            font-size: 11px;
            color: var(--text-dim);
            padding: 4px 16px;
            font-style: italic;
        }

        /* ── Input Bar ────────────────────────────────────────────────────── */
        #input-bar {
            padding: 10px 16px;
            background: var(--bg-sidebar);
            border-top: 1px solid var(--border);
        }

        #input-wrap {
            display: flex;
            align-items: flex-end;
            gap: 8px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 6px 10px;
            transition: border-color .15s;
        }

            #input-wrap:focus-within {
                border-color: var(--blue);
            }

        #msg-input {
            flex: 1;
            background: transparent;
            border: none;
            outline: none;
            color: var(--text-primary);
            font-family: var(--font-ui);
            font-size: 13px;
            resize: none;
            max-height: 120px;
            line-height: 1.5;
        }

            #msg-input::placeholder {
                color: var(--text-dim);
            }

        #send-btn {
            padding: 5px 14px;
            border-radius: var(--radius);
            background: var(--blue);
            border: none;
            color: #fff;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: background .15s;
            flex-shrink: 0;
        }

            #send-btn:hover {
                background: var(--blue-light);
            }

            #send-btn:disabled {
                background: var(--border);
                cursor: not-allowed;
            }

        #input-hint {
            font-size: 10px;
            color: var(--text-dim);
            margin-top: 5px;
        }

        /* ── Right Sidebar — Users ────────────────────────────────────────── */
        #users-panel {
            width: 180px;
            min-width: 180px;
            background: var(--bg-sidebar);
            border-left: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        #users-header {
            padding: 12px;
            border-bottom: 1px solid var(--border);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--text-dim);
        }

        #user-list {
            flex: 1;
            overflow-y: auto;
            padding: 6px 0;
        }

        .user-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 5px 12px;
        }

            .user-item .u-avatar {
                width: 24px;
                height: 24px;
                border-radius: 50%;
                background: var(--bg-input);
                overflow: hidden;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 10px;
                font-weight: 700;
                color: var(--accent);
            }

                .user-item .u-avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .user-item .u-name {
                font-size: 12px;
                color: var(--text-primary);
            }

        /* ── Login Modal ──────────────────────────────────────────────────── */
        #login-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.75);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }

        #login-box {
            background: var(--bg-sidebar);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 32px 28px;
            width: 340px;
            box-shadow: 0 20px 60px rgba(0,0,0,.5);
        }

            #login-box .lb-logo {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 24px;
            }

                #login-box .lb-logo .logo {
                    width: 32px;
                    height: 32px;
                    background: var(--accent);
                    border-radius: 4px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-weight: 900;
                    font-size: 14px;
                    color: #fff;
                }

                #login-box .lb-logo span {
                    font-size: 18px;
                    font-weight: 700;
                }

            #login-box h2 {
                font-size: 16px;
                margin-bottom: 6px;
            }

            #login-box p {
                font-size: 12px;
                color: var(--text-muted);
                margin-bottom: 20px;
            }

        .form-group {
            margin-bottom: 14px;
        }

            .form-group label {
                display: block;
                font-size: 11px;
                font-weight: 600;
                color: var(--text-muted);
                margin-bottom: 5px;
                text-transform: uppercase;
                letter-spacing: .05em;
            }

            .form-group input, .form-group select {
                width: 100%;
                padding: 8px 10px;
                background: var(--bg-input);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                color: var(--text-primary);
                font-family: var(--font-ui);
                font-size: 13px;
                outline: none;
                transition: border-color .15s;
            }

                .form-group input:focus, .form-group select:focus {
                    border-color: var(--blue);
                }

        #join-btn {
            width: 100%;
            padding: 10px;
            border-radius: var(--radius);
            background: var(--accent);
            border: none;
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: background .15s;
        }

            #join-btn:hover {
                background: var(--accent-dim);
            }

        /* Create Room Modal */
        #create-modal {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.75);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 999;
        }

            #create-modal.open {
                display: flex;
            }

        #create-box {
            background: var(--bg-sidebar);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 24px;
            width: 320px;
            box-shadow: 0 20px 60px rgba(0,0,0,.5);
        }

            #create-box h3 {
                margin-bottom: 16px;
            }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 3px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: var(--text-dim);
            }

        /* Notification toast */
        #toast {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: var(--bg-sidebar);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 10px 16px;
            font-size: 12px;
            color: var(--text-primary);
            box-shadow: 0 4px 20px rgba(0,0,0,.4);
            transform: translateY(60px);
            opacity: 0;
            transition: transform .3s, opacity .3s;
            z-index: 500;
            max-width: 300px;
        }

            #toast.show {
                transform: translateY(0);
                opacity: 1;
            }
    </style>
</head>
<body>
    <!-- ── Login Overlay ──────────────────────────────────────────────────── -->
    <div id="login-overlay">
        <div id="login-box">
            <div class="lb-logo">
                <div class="logo">SO</div>
                <span>Stack Chat</span>
            </div>
            <h2>Join a Chat Room</h2>
            <p>Pick a display name and choose a room to get started.</p>
            <div class="form-group">
                <label>Display Name</label>
                <input type="text" id="username-input" placeholder="e.g. Jon Skeet" maxlength="30" />
            </div>
            <div class="form-group">
                <label>Room</label>
                <select id="room-select">
                    <option value="General">General</option>
                    <option value="Health">Health</option>
                    <option value="Automotive">Automotive</option>
                    <option value="C#">C#</option>
                    <option value="JavaScript">JavaScript</option>
                    <option value="SQL">SQL</option>
                    <option value="DevOps">DevOps</option>
                </select>
            </div>
            <button id="join-btn">Join Room →</button>
        </div>
    </div>
    <!-- ── Create Room Modal ──────────────────────────────────────────────── -->
    <div id="create-modal">
        <div id="create-box">
            <h3>Create New Room</h3>
            <div class="form-group">
                <label>Room Name</label>
                <input type="text" id="new-room-name" placeholder="e.g. Python" maxlength="30" />
            </div>
            <div class="form-group">
                <label>Description</label>
                <input type="text" id="new-room-desc" placeholder="Short description…" maxlength="80" />
            </div>
            <div style="display:flex;gap:8px;margin-top:16px;">
                <button id="cancel-create" class="action-btn" style="flex:1;padding:8px;">Cancel</button>
                <button id="confirm-create" style="flex:2;padding:8px;background:var(--accent);border:none;border-radius:4px;color:#fff;font-weight:700;cursor:pointer;">Create Room</button>
            </div>
        </div>
    </div>
    <!-- ── Main App ───────────────────────────────────────────────────────── -->
    <div id="app">
        <!-- Left: Rooms -->
        <div id="sidebar">
            <div id="sidebar-header">
                <div class="brand">
                    <div class="logo">SO</div>
                    Stack Chat
                </div>
            </div>
            <div id="rooms-label">Rooms</div>
            <div id="room-list"><!-- populated by JS --></div>
            <button id="create-room-btn">＋ Create Room</button>
        </div>
        <!-- Center: Messages -->
        <div id="chat-area">
            <div id="chat-header">
                <span id="current-room-title" class="room-title">Loading…</span>
                <span id="online-badge" style="margin-left:12px;">0 online</span>
                <span id="current-room-desc" class="room-desc"></span>
            </div>
            <div id="messages-wrap">
                <div class="day-separator">Today</div>
            </div>
            <div id="input-bar">
                <div id="input-wrap">
                    <textarea id="msg-input" rows="1" placeholder="Type a message… (Enter to send, Shift+Enter for newline)"></textarea>
                    <button id="send-btn">Send</button>
                </div>
                <div id="input-hint">Wrap code in backticks: `code here`</div>
            </div>
        </div>
        <!-- Right: Users -->
        <div id="users-panel">
            <div id="users-header">Users in room</div>
            <div id="user-list"><!-- populated by JS --></div>
        </div>
    </div>
    <!-- Toast -->
    <div id="toast"></div>
    <script>
$(function () {
  // ── State ────────────────────────────────────────────────────────────
  var currentUser = null;
  var currentRoom = null;
  var lastSender  = null;

  // ── SignalR Hub ──────────────────────────────────────────────────────
  var hub = $.connection.chatHub;

  // ── Server → Client callbacks ────────────────────────────────────────
  hub.client.receiveMessage = function (msg) {
    appendMessage(msg, false);
    scrollToBottom();
  };

  hub.client.loadHistory = function (messages) {
    $('#messages-wrap').html('<div class="day-separator">Today</div>');
    lastSender = null;
    $.each(messages, function (_, msg) { appendMessage(msg, true); });
    scrollToBottom();
  };

  hub.client.userJoined = function (userName, count) {
    appendSystem(userName + ' joined the room');
    updateOnlineBadge(count);
  };

  hub.client.userLeft = function (userName, count) {
    appendSystem(userName + ' left the room');
    updateOnlineBadge(count);
  };

  hub.client.roomJoined = function (roomName, users) {
    currentRoom = roomName;
    $('#current-room-title').text('# ' + roomName);
    updateUserList(users);
    setActiveRoom(roomName);
  };

  hub.client.roomsList = function (rooms) {
    renderRoomList(rooms);
    // Update login dropdown
    var sel = $('#room-select').empty();
    $.each(rooms, function (_, r) { sel.append($('<option>').val(r.name).text(r.name)); });
  };

  hub.client.newRoomCreated = function (room) {
    addRoomToList(room);
    // Add option to login dropdown
    $('#room-select').append($('<option>').val(room.name).text(room.name));
    showToast('New room created: ' + room.name);
  };

  hub.client.messageStarred = function (msgId, stars) {
    var badge = $('#msg-' + msgId + ' .star-badge');
    if (badge.length) badge.text('★ ' + stars);
    else $('#msg-' + msgId + ' .msg-content').append('<div class="star-badge">★ ' + stars + '</div>');
  };

  hub.client.error = function (msg) { showToast('⚠ ' + msg); };

  // ── Start connection ─────────────────────────────────────────────────
  $.connection.hub.start().done(function () {
    hub.server.getRooms();
    $('#join-btn').prop('disabled', false);
  }).fail(function () {
    showToast('Connection failed. Refresh and try again.');
  });

  // ── Login ─────────────────────────────────────────────────────────────
  $('#join-btn').prop('disabled', true).on('click', function () {
    var name = $.trim($('#username-input').val());
    var room = $('#room-select').val();
    if (!name) { showToast('Please enter a display name.'); return; }
    currentUser = name;
    hub.server.joinRoom(name, room);
    $('#login-overlay').fadeOut(200);
    $('#msg-input').focus();
  });

  $('#username-input').on('keypress', function (e) {
    if (e.which === 13) $('#join-btn').click();
  });

  // ── Send message ──────────────────────────────────────────────────────
  $('#send-btn').on('click', sendMessage);

  $('#msg-input').on('keydown', function (e) {
    if (e.which === 13 && !e.shiftKey) { e.preventDefault(); sendMessage(); }
  }).on('input', function () {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 120) + 'px';
  });

  function sendMessage() {
    var text = $.trim($('#msg-input').val());
    if (!text || !currentRoom) return;
    hub.server.sendMessage(text);
    $('#msg-input').val('').css('height', 'auto');
  }

  // ── Room switching ────────────────────────────────────────────────────
  $(document).on('click', '.room-item', function () {
    var room = $(this).data('room');
    if (room === currentRoom) return;
    lastSender = null;
    hub.server.joinRoom(currentUser, room);
  });

  // ── Star message ──────────────────────────────────────────────────────
  $(document).on('click', '.star-btn', function () {
    var id = $(this).closest('.msg-row').attr('id').replace('msg-', '');
    hub.server.starMessage(id);
  });

  // ── Create room ───────────────────────────────────────────────────────
  $('#create-room-btn').on('click', function () { $('#create-modal').addClass('open'); });
  $('#cancel-create').on('click', function () { $('#create-modal').removeClass('open'); });
  $('#confirm-create').on('click', function () {
    var name = $.trim($('#new-room-name').val());
    var desc = $.trim($('#new-room-desc').val());
    if (!name) return;
    hub.server.createRoom(name, desc);
    $('#new-room-name, #new-room-desc').val('');
    $('#create-modal').removeClass('open');
  });

  // ── Render helpers ────────────────────────────────────────────────────
  function appendMessage(msg, isHistory) {
    var wrap   = $('#messages-wrap');
    var isSame = lastSender === msg.userName;
    lastSender = msg.userName;
    var isMine = msg.userName === currentUser;

    var avatarHtml = '<div class="avatar">' +
      '<img src="https://www.gravatar.com/avatar/' + msg.gravatarHash + '?s=64&d=identicon" alt="avatar" />' +
      '</div>';

    var metaHtml = !isSame
      ? '<div class="msg-meta">' +
          '<span class="msg-username">' + escHtml(msg.userName) + '</span>' +
          '<span class="msg-time">' + formatTime(msg.timestamp) + '</span>' +
        '</div>'
      : '';

    var textHtml = '<div class="msg-text">' + formatText(msg.message) + '</div>';

    var actionsHtml = '<div class="msg-actions">' +
      '<button class="action-btn star-btn" title="Star this message">★</button>' +
    '</div>';

    var rowHtml = '<div class="msg-row" id="msg-' + msg.id + '">' +
      (!isSame ? avatarHtml : '<div style="width:32px;flex-shrink:0;"></div>') +
      '<div class="msg-content">' + metaHtml + textHtml + '</div>' +
      actionsHtml +
    '</div>';

    wrap.append(rowHtml);
  }

  function appendSystem(text) {
    $('#messages-wrap').append('<div class="sys-msg">— ' + escHtml(text) + ' —</div>');
    scrollToBottom();
  }

  function renderRoomList(rooms) {
    var list = $('#room-list').empty();
    $.each(rooms, function (_, r) { list.append(buildRoomItem(r)); });
  }

  function addRoomToList(room) {
    $('#room-list').append(buildRoomItem(room));
  }

  function buildRoomItem(r) {
    var initial = (r.name || '?').charAt(0).toUpperCase();
    return $('<div class="room-item" data-room="' + escAttr(r.name) + '">' +
      '<div class="room-icon">' + escHtml(initial) + '</div>' +
      '<div class="room-meta">' +
        '<div class="room-name">' + escHtml(r.name) + '</div>' +
        '<div class="room-count">' + r.userCount + ' online</div>' +
      '</div>' +
    '</div>');
  }

  function setActiveRoom(name) {
    $('.room-item').removeClass('active');
    $('.room-item[data-room="' + escAttr(name) + '"]').addClass('active');
    $('#current-room-title').text('# ' + name);
  }

  function updateUserList(users) {
    var list = $('#user-list').empty();
    $.each(users, function (_, u) {
      list.append('<div class="user-item">' +
        '<div class="u-avatar"><img src="https://www.gravatar.com/avatar/' + u.gravatarHash + '?s=48&d=identicon" /></div>' +
        '<span class="u-name">' + escHtml(u.userName) + '</span>' +
      '</div>');
    });
  }

  function updateOnlineBadge(count) {
    $('#online-badge').text(count + ' online');
  }

  function formatTime(ts) {
    var d = new Date(ts);
    return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  }

  function formatText(text) {
    // Code spans
    text = escHtml(text);
    text = text.replace(/`([^`]+)`/g, '<code>$1</code>');
    // URLs
    text = text.replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" target="_blank" rel="noopener" style="color:var(--blue-light)">$1</a>');
    // Newlines
    text = text.replace(/\n/g, '<br>');
    return text;
  }

  function scrollToBottom() {
    var wrap = document.getElementById('messages-wrap');
    wrap.scrollTop = wrap.scrollHeight;
  }

  function showToast(msg) {
    var t = $('#toast').text(msg).addClass('show');
    setTimeout(function () { t.removeClass('show'); }, 3000);
  }

  function escHtml(s) {
    return $('<div>').text(s || '').html();
  }

  function escAttr(s) {
    return (s || '').replace(/"/g, '&quot;');
  }
});
    </script>
</body>
</html>


