@using EthioNegarit.Utilities
@using EthioNegarit.WebUI.ViewModels
@model ChatRoomsViewModel
@{
    Layout = "~/Views/Shared/_LayoutFullWidth.cshtml";
    ViewBag.Title = Html.LanguageString("Layout.Nav.ChatRooms");
}

<div class="container chatrooms-page">
    <div class="row align-items-center mb-2 mt-3">
        <div class="col-md-6">
            <h2 class="chatrooms-title">@Html.LanguageString("Layout.Nav.ChatRooms")</h2>
        </div>
        <div class="col-md-6">
            <div class="input-group chatrooms-search">
                <input type="text" id="chatRoomSearch" class="form-control" placeholder="@Html.LanguageString("Chat.SearchPlaceholder")" autocomplete="off" />
                <div class="input-group-append">
                    <span class="input-group-text"><i class="fas fa-search" aria-hidden="true"></i></span>
                </div>
            </div>
        </div>
    </div>
    <p class="text-muted chatrooms-subtitle">@Html.LanguageString("Chat.Subtitle")</p>

    <div id="chatRoomGrid">
        @Html.Partial("_chatRooms", Model)
    </div>
</div>

<style>
    .chatrooms-title { font-weight: 600; }
    .chatrooms-subtitle { margin-bottom: 18px; }
    .chatrooms-search { max-width: 520px; margin-left: auto; }
    .chat-room-card {
        position: relative;
        height: 100%;
        border: 1px solid rgba(0,0,0,.10);
        border-radius: 8px;
        transition: box-shadow .15s, border-color .15s, transform .15s;
    }
    .chat-room-card:hover {
        box-shadow: 0 6px 18px rgba(0,0,0,.10);
        border-color: var(--accent, #379fef);
        transform: translateY(-2px);
    }
    .chat-room-card .card-body { display: flex; flex-direction: column; }
    .chat-room-card .room-avatar {
        width: 56px; height: 56px; border-radius: 50%;
        object-fit: cover; background: #eef1f4;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 22px; color: #6c757d;
    }
    .chat-room-card .room-name { font-weight: 600; font-size: 1.05rem; }
    .chat-room-card .room-preview {
        color: #8a939b; font-size: .85rem; min-height: 2.4em;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .chat-room-card .room-stats { color: #8a939b; font-size: .8rem; }
    .chat-room-card .room-stats > span { margin-right: 14px; white-space: nowrap; }
    .chat-room-card .room-fav {
        position: absolute; top: 10px; right: 12px; font-size: 1rem;
    }
    .chat-room-card .room-fav .fa-star { color: #f4c430; }
    .chat-room-card .room-fav .fa-star.o { color: #cdd3d8; }
</style>

<script>
    (function () {
        var box = document.getElementById('chatRoomSearch');
        if (!box) return;
        box.addEventListener('input', function () {
            var q = (this.value || '').toLowerCase();
            var cards = document.querySelectorAll('#chatRoomGrid [data-room-name]');
            for (var i = 0; i < cards.length; i++) {
                var name = (cards[i].getAttribute('data-room-name') || '').toLowerCase();
                cards[i].style.display = name.indexOf(q) !== -1 ? '' : 'none';
            }
        });
    })();
</script>
