@using EthioNegarit.WebUI.ViewModels
@model ChatModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Model.ChatRoom.Name + " - Chat";
    <input class="roomId" id="roomId" type="hidden" name="roomId" value="@Model.ChatRoom.Id" />
    <input class="userId" id="userId" type="hidden" name="userId" value="@Model.UserId" />
    var logonMessage = string.Format(string.Concat(@Html.CurrentMember().UserName, @Html.LanguageString("Chat.Room.Joined")));

}
@section Header
        {
    <script>
        $(function () {
              //  LoadChatMessages();
                GetMembers();
                GetRooms();
            });
    </script>
}
<!-- Page header -->
<div class="page-header">
    <span class="">
        <a title="@Model.ChatRoom.Name" href="@Html.Raw(@Model.ChatRoom.NiceUrl)" class="">
            @ViewBag.Title
        </a>
    </span>
    <span class="width-25">
        <a class="btn btn-block btn-xs btn-outline-success" href="@Url.Action("Index", "Chat")">&larr; @Html.LanguageString("Chat.Rooms")</a>
    </span>
</div>
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <section class="col-sm-9">
                <div class="chat-messages" id="chat-messages">
                    <div class="clearfix"></div>
                    <div class="centered">
                        <div class="content-center">
                            <span class="spmloading ajaxspinner">
                                <i class="fa fa-spinner fa-spin"></i>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="footer-fixed">
                    <div class="newchatmessage" id="newchatmessage" style="">
                        @Html.Partial("_createMessage", new CreateMessageViewModel { RoomId = Model.ChatRoom.Id, IsReplay = false, ReplyToUsername = "", Message = "" })
                    </div>
                    <div class="status">Connecting...</div>
                </div>
            </section>
            <section class="col-sm-3 side-panel">
                <div class="panel-content">
                    <div id="logonMessage" class="text-xs float-center" style="color: Green"></div>
                    <div id="LastRefresh" class="text-sm text-muted">
                    </div>
                    <div class="popup bottom-right">
                    </div>
                    <div id="roomMembers">
                        <span class="spmloading ajaxspinner float-center">
                            <i class="ethicon fa fa-spinner fa-spin"></i>
                        </span>
                    </div>
                </div>
                <div id="chatRooms">
                </div>
            </section>
        </div>
    </div>
</section>

<!-- Reference the SignalR library. -->
<script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
<!-- Reference the autogenerated SignalR hub script. -->
<script src="~/signalr/hubs"></script>
<script type="text/javascript">
    $(function () {
        var roomId = '@Model.ChatRoom.Id';
        var $chatMessages = $('#chat-Messages');
        var $input = $('#messageInput');
        var $send = $('.sendButton');
        var $status = $('.status');
        var $replay = $('.chatreplylink');
        // ----- SignalR wiring -----
        var chat = $.connection.chatHub;
        // ── Server → Client callbacks ────────────────────────────────────────
        // Server -> client: a new message arrived in this room.
        chat.client.updateMessages = function () {
            $status.text('Messages Updated');
            LoadChatMessages();
            $("#messageInput").val("").css("height", "auto");
            var atBottom = isNearBottom();
            if (atBottom) { scrollToBottom(); }
            $input.focus();
            $status.text('Messages Updated');
        };
        chat.client.refreshOnlineUsers = function () {
            $("#logonMessage").text('@logonMessage');
            ShowLogMessage();
            refreshInterval = setInterval("Refresh();", 10 * 1000);
        };
        // ── Send message ──────────────────────────────────────────────────────//
        function sendMessage() {
            var content = $("#messageInput").val().trim();
            if (!content) { return; }
            chat.server.sendMessage(roomId, content);
           $status.text('Message Send');
           $("#logonMessage").text('@logonMessage');
           ShowLogMessage();
         //   $("#messageInput").val("").css("height", "auto");
            //  clearReply();
        }
         $send.on('click', sendMessage);
            $input.on('keypress', function (e) {
                if (e.which === 13 && !e.shiftKey) {
                e.preventDefault();
                sendMessage();               
            }
            /* else {
                 startTyping();
             }*/
        }).on("input", function () {
            // Auto-grow
            this.style.height = "auto";
            this.style.height = Math.min(this.scrollHeight, 120) + "px";
            //  $("#charCount").text(this.value.length);
        });
        $.connection.hub.start()
           .done(function () {
               chat.server.joinRoom(roomId);
               $status.text('Connected');
               $status.css('color', 'Green');
              // $send.prop('disabled', false);
               LoadChatMessages();
               CreateMessage();
               refreshInterval = setInterval("Refresh();", 10 * 1000);
               console.log('SignalR connection started.');
           })
           .fail(function () {
               $status.text('Could not connect. Refresh to retry.');
               $send.prop('disabled', true);
               console.error('Error starting SignalR connection: ' + err.toString());
           });
        $.connection.hub.disconnected(function () {
            setTimeout(function () {
                $.connection.hub.start();
            }, 5000); // Restart connection after 5 seconds.
       });      
    });
    // ── Render helpers ────────────────────────────────────────────────────
    function isNearBottom() {
        var el = $chatMessages[0];
        return el.scrollHeight - el.scrollTop - el.clientHeight < 60;
    }
    // ── State ────────────────────────────────────────────────────────────
    function scrollToBottom() {
        $chatMessages.scrollTop($chatMessages[0].scrollHeight);
    }
    function ShowLogMessage() {
        setTimeout(function () {
            $("#logonMessage").delay(5000).fadeOut();
        }, 5000)
    }
</script>