@using EthioNegarit.WebUI.ViewModels
@model AdListViewModel
@{
    ViewBag.Title = @Html.Lang("SubNav.MyAdvertisements");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var totalCount = Convert.ToInt32(Model.TotalCount);
 //   var loggedOnUserId = Html.CurrentMember() != null ? Html.CurrentMember().Id : Guid.Empty;
}
<div class="page-header">
    <span class="">
        @ViewBag.Title
    </span>
    <span class="width-25">
        @if (User.Identity.IsAuthenticated)
            {
            @Html.Action("CreateAdButton", "Ad")
        }
    </span>
</div>
<section class="content">
    <div class="container-fluid">
        <div class="row mb-4">
            <section class="col-sm-12">
                @if (Model.Advertisements != null)
                {
                    <ul class="contents-list">
                        @foreach (var ad in Model.Advertisements)
                        {
                            <li class="content-fluid">
                                @{
                                    Html.RenderPartial("_adSlim", ad);
                                }
                            </li>
                                    }
                    </ul>
                                    if (Model.TotalPages > 1)
                                    {
                                        <ul>
                                            <li class="pagination">
                                                @Html.Pager(Convert.ToInt32(Model.PageIndex), SiteConstants.Instance.PagingGroupSize, totalCount, null)
                                            </li>
                                        </ul>
                                        }
                                    }
            </section>
        </div>
    </div>
</section>