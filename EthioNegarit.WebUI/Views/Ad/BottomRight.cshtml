            <div class="ad ad-bottom-right">
                <button type="button" class="close" data-dismiss="ad-bottom-rightt" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                @if (!string.IsNullOrEmpty(Model.Advertisement.Image))
                {
                    <div class="float-center">
                        <img class="img-circle img-size-64 img-bordered-sm" src="@AppHelpers.AdvertImage(Model.Advertisement.Image, Model.Advertisement.Id, 110)" alt="@Model.Advertisement.Name">
                    </div>
                }
                <div class="company-name text-sm float-center">
                    <a href=" @Model.Advertisement.NiceUrl" title=" @Model.Advertisement.Name">
