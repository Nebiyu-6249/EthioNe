                    @Model.Advertisement.MotoSlogan
                </div>
                <div class="content-text text-xs">
                    @Html.Raw(string.Concat(StringUtils.ReturnAmountWordsFromString(StringUtils.StripHtmlFromString(@Model.Advertisement.About), 25), "...."))
                </div>
                <div class="content-footer">
                    @if (@Model.Advertisement.LinkUrl != null)
                    {
                        <a href="@Model.Advertisement.LinkUrl" target="_blank" class="btn btn-xs text-info" title="@Model.Advertisement.Name">
                            <i class="fas fa-external-link-alt" aria-hidden="true">
                                @if (@Model.Advertisement.LinkText != null)
                                {
                                    @Model.Advertisement.LinkText
                                }
                                else
