@model EthioNegarit.WebUI.ViewModels.CreatePostReportViewModel

@using (Ajax.BeginForm("PostReport", "Report", null, new AjaxOptions
    {
    HttpMethod = "POST",
    LoadingElementId = "submitreportwait",
    OnSuccess = "AjaxReportSuccess()",
    OnFailure = "AjaxReportError('Error creating Report')",
    OnBegin = "AjaxReportBegin()"
    }, new { @id = "reportcodeform", @class = "form-createreport" }))
    {
    @Html.HiddenFor(x => x.PostId)
    <p>@Html.LanguageString("Post.By") - @Model.PostCreatorUsername</p>
    <div class="card-footer">
        <div class="input-group">
            <textarea class="form-control required reason" id="reason" name="Reason" placeholder="@Html.LanguageString("Report.Text")"></textarea>
        </div>
    </div>
    @Html.ValidationMessageFor(x => x.Reason)
    <div class="row submit-holder">
        <div class="col-sm-6">
            <input type="reset" id="" class="btn btn-default btn-sm btn-block reset" value="@Html.LanguageString("Buttons.Clear")" />
        </div>
        <div class="col-sm-6">
            <input type="submit" id="submitreport" data-id="@Model.PostId" data-confirmation="@Html.LanguageString("Report.Sent")" class="btn btn-outline-success btn-sm btn-block submitreport" value="@Html.LanguageString("Buttons.Submit")" />
        </div>
        <span style="display: none;" id="submitreportwait" class="ajaxspinner" title="@Html.LanguageString("Post.PleaseWait")">@Html.LanguageString("Post.PleaseWait")</span>
    </div>
    }

