@using EthioNegarit.Core.Domain.General
@{
    // Global Stuff
    var themeName = Html.Settings().Theme;
    var theme = new Theme
    {
        ThemeName = themeName,
        ThemePath = string.Concat(SiteConstants.Instance.ThemeRootFolder, themeName)
    };
    TempData[AppConstants.GlobalClass] = Convert.ToBoolean(PageData[AppConstants.IsMobileDevice]) ? "mobile" : "desktop";
    TempData[AppConstants.CurrentAction] = ViewContext.RouteData.GetRequiredString("action").ToLower();
    TempData[AppConstants.CurrentController] = ViewContext.RouteData.GetRequiredString("controller").ToLower();
}
<!DOCTYPE html>
<html lang="en">
<head prefix="og: http://ogp.me/ns# fb: http://ogp.me/ns/fb# website: http://ogp.me/ns/website#">

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title</title>
    <meta name="description" content="@ViewBag.MetaDesc" />
    <meta property="og:url" content="@HttpContext.Current.Request.Url.AbsoluteUri" />
    <meta property="og:description" content="@ViewBag.MetaDesc" />
    <meta property="og:title" content="@ViewBag.Title" />
    <meta property="og:site_name" content="@Html.Settings().ForumName" />
    <meta property="og:type" content="website" />
    @* <meta property="og:image" content="~/Content/images/ethNegarit-icon.png">*@
    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="@Url.Content("~/Content/images/ethNegarit-icon.png")">
    @*<link rel="website icon" type="png" href="@Url.Content("~/Content/images/ethNegarit-icon.png")">*@
 @*   <link rel="shortcut icon" href="@Url.Content(theme.ThemePath + "/content/images/favicon.ico")">*@
    <link rel="apple-touch-icon-precomposed" href="@Url.Content("~/Content/images/ethNegarit-icon.png")">
   <link href="http://ajax.googleapis.com/ajax/libs/jqueryui/1.8.9/themes/base/jquery-ui.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>

    @ViewBag.Canonical
    @RenderSection("SocialMeta", false)
    @Html.Partial("_StyleSheets", theme)
    <!--[if lt IE 9]>
            <script src="http://html5shim.googlecode.com/svn/trunk/html5.js"></script>
    <![endif]-->

    @Html.Partial("_JavaScript", theme)
    @RenderSection("Header", false)
    @if (!string.IsNullOrEmpty(Html.Settings().CustomHeaderCode))
    {
        @Html.Raw(Html.Settings().CustomHeaderCode)
    }
</head>
<body class="@TempData[AppConstants.GlobalClass].ToString() loggedin-@(User.Identity.IsAuthenticated.ToString().ToLower()) hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        @Html.Partial("_Header")
        @Html.Partial("_SideNav")
                 
      @*  <div class="popup bottom-left">
    </div>*@
       @* <div class="popup bottom-right">
    </div>*@            
        <div class="content-wrapper"> 
          @Html.Partial("_setting")
            <div id="notification" class="notification-popover notification-popover-content right-bottom notification"></div>
            <div id="notice" class="notification-popover notification-popover-content right-bottom notice"></div>
           @*     <div class="popup popup-top">
    </div>
    <div class="popup popup-bottom">
    </div>*@
       
                @Html.Partial("_EmailConfirmationNotice")
                @Html.Partial("_GenericMessage")
                @Html.Partial("_NoScript")
                @RenderBody()
                @Html.Partial("_slideOutPanel")              
            <div id="copylink" class="modal fade" tabindex="-1" role="dialog">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Copy Link</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body" id="modal-copylink">
                        </div>
                    </div>
                </div>
            </div>
            <div id="memberreport" class="modal fade" tabindex="-1" role="dialog">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-body" id="modal-memberreport">
                        </div>
                    </div>
                </div>
            </div>
            </div>
    </div>
@*   
    <script>
    $.widget.bridge('uibutton', $.ui.button)
    </script>*@
    <!--
    RenderSection("scripts", required: false)
    -->
</body>
</html>
