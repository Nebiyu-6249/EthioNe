<footer>
    <div class="container footer_container">
        <div class="footer-one">
            <a href="@Html.Settings().ForumUrl" class="footer-logo">
                <h4>@Html.Settings().ForumName</h4>
                <p>@Html.LanguageString("Site.Moto")</p>
            </a>
        </div>
        <div class="footer-two">
            <h4>@Html.LanguageString("Home.Permalinks")</h4>
            <ul class="permalinks">
                <li><a href="@Url.Action("Index", "Topic")">@Html.LanguageString("Layout.Nav.Discussions")</a></li>
                <li><a href="@Url.Action("FAQ","Home")">@Html.LanguageString("Help.FAQ")</a></li>
                @if (Html.Settings().EnableAd)
                {
                    <li><a href="@Url.Action("Index", "Ad")">@Html.LanguageString("SubNav.AdService")</a></li>
                }
            </ul>
        </div>
        <div class="footer-three">
            <h4 class="text-centerr">@Html.Lang("Home.PrivacyAndSecurity")</h4>
            <ul class="privacy">
                <li><a href="@Url.Action("Index", "Privacy")">@Html.LanguageString("Layout.PrivacyPolicy")</a></li>
                <li><a href="@Url.Action("Terms", "Privacy")">@Html.LanguageString("Layout.TermsAndConditions")</a></li>
            </ul>
        </div>
        <div class="footer-four">
            <h4>@Html.LanguageString("Home.ContactUs")</h4>
            <ul class="privacy">
                <li><a href="@Url.Action("About", "Home")">@Html.LanguageString("Layout.Nav.About")</a></li>
                <li><a href="@Url.Action("ContactUs", "Home")">@Html.LanguageString("Layout.Nav.SendUsMessage")</a></li>
                <li>@Html.Raw(Html.Settings().NotificationReplyEmail)</li>
            </ul>
            <ul class="footer-socials">
                <li><a href="#"><img class="social-icons" src="~/content/Images/social-icons/icon-facebook.svg" alt="facebook"></a></li>
                <li><a href="index.html"><i class="fab fa-facebook"></i></a></li>
                <li><a href="index.html"><i class="fab fa-twitter"></i></a></li>
                <li><a href="index.html"><img class="social-icons" src="~/Content/Images/social-icons/icon-twitter.svg" alt="twitter"></a></li>
                <li><a href="index.html"><img class="social-icons" src="~/Content/Images/social-icons/icon-youtube.svg" alt="youtube"></a></li>
            </ul>
        </div>
    </div>
    @*******Footer Copy Right********@
    <div class="footer-copyright">
        <small>@Html.LanguageString("Text.Copyright") &copy; @DateTime.UtcNow.Year <a href="@(Html.Settings().ForumUrl)">@Html.Settings().ForumName</a>.</small>
        @Html.LanguageString("Text.AllRights")
        <div class="float-right d-none d-sm-inline-block">@Html.Partial("_GetCurrentVersion")</div>
    </div>
    @if (!string.IsNullOrEmpty(Html.Settings().CustomFooterCode))
            {
        @Html.Raw(Html.Settings().CustomFooterCode)
    }
</footer>
