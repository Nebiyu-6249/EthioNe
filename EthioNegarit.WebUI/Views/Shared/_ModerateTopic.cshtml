@model  EthioNegarit.Core.Domain.Entities.Topic
@{
    var userId = Html.CurrentMember().Id;
}
<div class="topicsnippet" id="topic-@Model.Id">
    <div class="row">
        <div class="col-sm-9">
            <h2>@Model.Name</h2>
            <p>@Html.Raw(AppHelpers.ConvertPostContent(Model.LastPost.PostContent))</p>
            <p class="postuser">@Model.LastPost.User.UserName</p>
        </div>
        <div class="col-sm-3">
@if (User.IsInRole(AppConstants.AdminRoleName))
{
            <p><a href="#" data-topicid="@Model.Id" data-topicaction="approve" class="btn btn-sm btn-success btn-block topicaction">Approve</a></p>
}
@if (Model.User.Id == userId || User.IsInRole(AppConstants.AdminRoleName))
{
            <p><a href="#" data-topicid="@Model.Id" data-topicaction="delete" class="btn btn-sm btn-danger btn-block topicaction">Delete</a></p>
}
        </div>
    </div>
</div>