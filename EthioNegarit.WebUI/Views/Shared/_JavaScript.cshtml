@model EthioNegarit.Core.Domain.General.Theme
<script type="text/javascript">
    var app_base = '@Url.Content("~/")';
    var largeSpinnerBlockImage = '@Url.Content("~/content/Images/ajaxloader-large.gif")';
</script>
@*
    NullMinifier: concatenate the scripts into one cached file but do NOT minify.
    SquishIt's default JS minifier (Microsoft Ajax Minifier / AjaxMin) is ES5-only
    and stalls indefinitely trying to parse the ES6 syntax in several bundled files
    (advert.js, payment.js, general.js, chat.js, topicPost.js, Chart.js, ...). With
    debug="false" ASP.NET drops the request execution timeout, so that stall shows as
    the home page hanging forever on first render. Skipping minification removes the
    AjaxMin parse entirely; the combined file is larger but IIS gzip recovers most of
    the size over the wire. The single-request concatenation/caching benefit is kept.
*@
@(SquishIt.Framework.Bundle.JavaScript()
    .WithMinifier<SquishIt.Framework.Minifiers.JavaScript.NullMinifier>()
    .Add("~/Scripts/jquery-3.1.0.min.js")
    .Add("~/Scripts/jquery-ui.min.js")
    .Add("~/Scripts/jquery.unobtrusive-ajax.js")
    .Add("~/Content/bootstrap/js/bootstrap.min.js")
    .Add("~/Scripts/jquery.validate.min.js")
    .Add("~/Scripts/jquery.validate.unobtrusive.min.js")
    .Add("~/Scripts/fancybox/jquery.fancybox.js")
    .Add("~/Scripts/plugins.js")



  .Add("~/Scripts/language.js")
  .Add("~/Scripts/badges.js")
  .Add("~/Scripts/chat.js")
  .Add("~/Scripts/report.js")
  .Add("~/Scripts/slideoutpanel.js")
  .Add("~/Scripts/privatemessage.js")
  .Add("~/Scripts/topicPost.js")
  .Add("~/Scripts/notifications.js")
  .Add("~/Scripts/advert.js")
  // .Add("~/Scripts/cardwidget.js")
  .Add("~/Scripts/Chart.js")
  .Add("~/Scripts/payment.js")
  .Add("~/Scripts/popover.js")
  .Add("~/Scripts/general.js")
  .Add("~/Scripts/main.js")
  .Add($"{Model.ThemePath}/Scripts/general.js")
  .MvcRender($"~/scripts/cache/combined_{Model.ThemeName}_#.js")
)
