@using EthioNegarit.WebUI

@if (Html.Settings().EnableSocialLogins == true)
{
    <div class="loginortext">
        @Html.LanguageString("Members.LoginWith")
    </div>
<div class="oauthbuttonss social-auth-linkss text-centerr list-inline float-center">   
    @if (!string.IsNullOrEmpty(SiteConstants.Instance.FacebookAppId) && !string.IsNullOrEmpty(SiteConstants.Instance.FacebookAppSecret))
    {  
        <span>
       <a href="@Url.Action("FacebookLogin", "FacebookOAuth" )" class="btn btn-sm btn-blockk btn-infoo facebookloginbutton">
        <i class="fab fa-facebook mr-2"></i>
        @Html.LanguageString("Members.LogonFacebookButton")
    </a>
    </span>
    }
    @if (!string.IsNullOrEmpty(SiteConstants.Instance.GooglePlusAppId) && !string.IsNullOrEmpty(SiteConstants.Instance.GooglePlusAppSecret))
    {
        <span>
        <a class="btn btn-sm  btn-blockk btn-dangerr googleloginbutton" href="@Url.Action("GoogleLogin", "GoogleOAuth" )">
            <i class="fab fa-google-plus mr-2"></i> 
            @Html.LanguageString("Members.LogonGoogleButton")
        </a>
        </span>
    }
    @if (!string.IsNullOrEmpty(SiteConstants.Instance.MicrosoftAppId) && !string.IsNullOrEmpty(SiteConstants.Instance.MicrosoftAppSecret))
    {
        <span>
            <a class="btn btn-sm  btn-blockk btn-infoo microsoftloginbutton" href="@Url.Action("MicrosoftLogin", "MicrosoftOAuth" )">
                <i class="fab fa-windows mr-2"></i> @Html.LanguageString("Members.LogonMicrosoftButton")
            </a>
        </span>
    }
</div>
}