@model EthioNegarit.Core.Domain.General.Theme
<link href="http://ajax.googleapis.com/ajax/libs/jqueryui/1.8.9/themes/base/jquery-ui.css" rel="stylesheet" type="text/css" />
@(Bundle.Css()
      .Add($"{Model.ThemePath}/dist/imports.css")
      .Add("~/Scripts/fancybox/jquery.fancybox.css")
      .Add("~/Content/bootstrap/css/bootstrap.min.css")
      .Add("~/Content/plugins/fontawesome-free-5.15.4-web/css/all.min.css")
      .Add($"{Model.ThemePath}/dist/style.min.css")
      .MvcRender($"~/content/cache/combined_{Model.ThemeName}_#.css"))
