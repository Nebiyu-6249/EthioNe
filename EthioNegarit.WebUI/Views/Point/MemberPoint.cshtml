@model EthioNegarit.WebUI.ViewModels.ChartViewModel
 <!-- Page header -->
<div class="page-header">
                <span class="">
                   @Model.Year @Html.LanguageString("Dashboard.Title.PointSummary")
                </span>
               @if (Model.Years.Count() > 1)
               {
                <span class="d-none d-sm-inline-block">@Html.LanguageString("Dashboard.Title.SelectYear")</span>
                <span class="yearselector">
                    @Html.DropDownListFor(model => model.Year, new SelectList(Model.Years, "Text", "Value"))
                </span>
               }
    </div>
<div class="divider clearfix"></div>
    <div class="row">
        <div class="col-sm-12">
            @* <div style="width:365px; height:300px;text-align:center">
                <canvas id="myChart2" style="width:365px; height:300px;"></canvas>*@
            <div style="width:100%; height:300px;text-align:center; background:rgba(14, 4, 4, 0.16)">
                <canvas id="pointChart" style="width:100%; height:300px;"></canvas>
                <script>
                    $(document).ready(function () {
                        ChangeYear();
                    });
                    var ctx = document.getElementById("pointChart").getContext("2d");
                    //  var ymax = 1000;
                    //   var ymax = Model.YMax;
                    var data = {
                        labels: ["January"+ " " +@Model.Year, "February" + " " +@Model.Year, "March" + " " +@Model.Year, "April" + " " +@Model.Year, "May" + " " +@Model.Year, "June" + " " +@Model.Year, "July" + " " +@Model.Year, "August" + " " +@Model.Year, "September" + " " +@Model.Year, "October" + " " +@Model.Year, "November" + " " +@Model.Year, "December" + " " +@Model.Year],
                        datasets: [{
                            label: "@Html.LanguageString("Dashboard.Label.PointsGet")",
                            backgroundColor: "#36a2eb",
                            fill: true,
                            //  fill: false,
                            borderColor: "green",
                            pointRadius: 2,
                            data: [@Model.pointchart_ds1_point_J,@Model.pointchart_ds1_point_F,@Model.pointchart_ds1_point_M,@Model.pointchart_ds1_point_A,@Model.pointchart_ds1_point_MY,@Model.pointchart_ds1_point_JU,@Model.pointchart_ds1_point_JY,@Model.pointchart_ds1_point_AG,@Model.pointchart_ds1_point_S,@Model.pointchart_ds1_point_O,@Model.pointchart_ds1_point_N,@Model.pointchart_ds1_point_D]
                        }]
                        @*                   {
                            label: "Points Deduct",
                            // backgroundColor: "#9bbb59",
                            fill: false,
                            borderColor: "red",
                            pointRadius: 2,

                            data: [@Model.pointchart_ds1_point_J,@Model.pointchart_ds1_point_F,@Model.pointchart_ds1_point_M,@Model.pointchart_ds1_point_A,@Model.pointchart_ds1_point_MY,@Model.pointchart_ds1_point_JU,@Model.pointchart_ds1_point_JY,@Model.pointchart_ds1_point_AG,@Model.pointchart_ds1_point_S,@Model.pointchart_ds1_point_O,@Model.pointchart_ds1_point_N,@Model.pointchart_ds1_point_D]
                        }]*@
                    };

                    var myBarChart = new Chart(ctx, {
                        type: 'line',
                        data: data,
                        // fill: false,
                        //  borderColor: "red",
                        options: {
                            responsive: true,
                            animation: false,
                            legend: {
                                display: true
                            },
                            title: {
                                display: true,
                                text:  @Model.Year + " " +'@Html.LanguageString("Dashboard.Title.PointSummary")'
                            },
                            barValueSpacing: 20,
                            scales: {
                                yAxes: [{
                                    ticks: {
                                        min: @Model.YMin,
                                        //max: ymax,
                                        max:@Model.YMax,
                                        // max: 1000,
                                    }
                                }]
                            }
                        }
                    });

                    function ChangeYear() {
                        var yearSelect = $(".yearselector select");
                        if (yearSelect.length > 0) {
                            yearSelect.change(function () {
                                var year = this.value;
                                $.ajax({
                                    url: app_base + "Point/MemberPoint",
                                    type: "GET",
                                    cache: false,
                                    data: { y: year},
                                    success: function (data) {
                                        $(".memberPoint").html("");
                                        $(".memberPoint").html(data);
                                    },
                                    error: function (xhr, ajaxOptions, thrownError) {
                                        ShowUserMessage("Error: " + xhr.status + " " + thrownError);
                                    }
                                });
                            });
                        }
                    }
                </script>
            </div>
        </div>
    </div>
