@using EthioNegarit.WebUI.ViewModels
@model HighEarnersPointViewModel
@{ 
    var date = DateTime.UtcNow.AddMinutes(-AppConstants.TimeSpanInMinutesToShowMembers);
}

    <ul class="contents-list">
        @foreach (var dict in Model.HighEarners.Where(x => x.Value > 0))
        {
        <li class="content-fluid  clearfix">
            <div class="member-slim">
                <a id="@dict.Key.Id" class="show-pop-delay" href="@dict.Key.NiceUrl" role="button" data-delay-show="300" data-delay-hide="1000" data-placement="left">
                    <div class="image">
                        <img class="img-circle @(dict.Key.LastActivityDate > date ? "img-bordered-success" : "img-bordered-sm")" src="@dict.Key.MemberImage(SiteConstants.Instance.GravatarLeaderboardSize)" alt="">
                    </div>
                    <div class="member-profile">
                        <span class="username">
                            @dict.Key.UserName
                        </span>
                        <span class="post-count">
                            @Html.LanguageString("Members.Profile.Posts")
                            @dict.Key.Posts.Count
                        </span>
                    </div>
                </a>
                    <div class="member-point">
                        <div class="circle circle-sm text-success">               
                                @dict.Value                     
                        </div>
                    </div>
              
				@Html.Partial("_memberPopover", new MemberPopUpViewModel
				{
				User = @dict.Key,
				})
              @*  @{
		@Html.Partial("_memberInfo", dict.Key);
	}*@
            </div>
        </li>
                    }
    </ul>

