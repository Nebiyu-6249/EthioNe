@{
    Layout = "~/Views/Shared/_LayoutFullWidth.cshtml";
    ViewBag.Title = Html.LanguageString("Members.ChangePassword.Success");
}
<section class="content">
    <div class="container-fluid">
        <div class="centered">
            <div class="mainheading">
                <h1>@ViewBag.Title</h1>
            </div>
            <p>@Html.LanguageString("Members.ResetPassword.SuccessText")</p>
            <p>@Html.ActionLink(Html.Lang("Layout.Nav.Logon"), "LogOn", "Members", null, new { @class = "btn btn-sm btn-outline-success btn-block" })</p>
        </div>
    </div>
</section>