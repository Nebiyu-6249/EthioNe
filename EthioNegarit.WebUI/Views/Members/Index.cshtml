                    </a>
                </div>
                <div class="member-bio">
                    <h4>
                        <a href="@user.NiceUrl" title="@user.UserName">
                            @user.UserName
                        </a>
                    </h4>
                    <p> Posts @user.TotalPoints</p>
                    <p> Posts @user.TotalPoints</p>
                </div>
                <div class="member-socials">
                    @if (!string.IsNullOrEmpty(user.facebook))
                    {
                    <a href="@user.facebook" target="_blank"><i class="fab fa-facebook"></i></a>
                    }
                    @if (!string.IsNullOrEmpty(user.twitter))
                    {
                    <a href="@user.twitter" target="_blank"><i class="fab fa-twitter"></i></a>
                    }
                    @if (!string.IsNullOrEmpty(user.web))
                    {
                    <a href="@user.web" target="_blank"><i class="fab fa-youtube"></i></a>
