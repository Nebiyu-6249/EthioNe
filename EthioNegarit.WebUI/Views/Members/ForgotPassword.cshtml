@model EthioNegarit.WebUI.ViewModels.ForgotPasswordViewModel
@{
    Layout = "~/Views/Shared/_LayoutFullWidth.cshtml";
    ViewBag.Title = Html.LanguageString("Members.ForgotPassword.Title");
}
<section class="content">
	<div class="container-fluid">
		<div class="fullscreen flex-container">
			<div class="content-center">
				@using(Html.BeginForm("ForgotPassword", "Members", FormMethod.Post, new { @class = "form-forgotpassword" }))
					{
					@Html.ValidationSummary(true)
					@Html.AntiForgeryToken()
					<fieldset>
						<legend>@ViewBag.Title</legend>
						<div class="form-group">
							@Html.LabelFor(m => m.EmailAddress)
							@Html.TextBoxFor(m => m.EmailAddress, new { @class = "form-control", type = "email", placeholder = @Html.LanguageString(" Members.Label.EmailAddressBlank") })
							@Html.ValidationMessageFor(m => m.EmailAddress)
						</div>
						<div class="submit-holder">
							<button type="submit" class="btn btn-sm btn-outline-success btn-block">@Html.LanguageString("Buttons.ResetPassword")</button>
						</div>
					</fieldset>
					}
			</div>
		</div>
	</div>
</section>
