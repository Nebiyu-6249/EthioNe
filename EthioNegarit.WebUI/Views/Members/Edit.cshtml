@using EthioNegarit.WebUI.Application.ExtensionMethods
@using EthioNegarit.WebUI.ViewModels
@model MemberFrontEndEditViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = @Html.LanguageString("Members.EditProfile");
    var settings = @Html.Settings();
}
<!-- Page header -->
<div class="page-header">
    <span>
        @Html.LanguageString("Members.EditProfile")
    </span>
</div>
<section class="content">
    <div class="container-fluid">
        <div class="mb-4">
                @using (Html.BeginForm("Edit", "Members", FormMethod.Post, new { enctype = "multipart/form-data", @class = "editmemberform" }))
                {
                    @Html.HiddenFor(x => Model.Id)
                    @Html.ValidationSummary(true)
                    @Html.AntiForgeryToken()
                        <div class="row form-group">
                            <div class="col-sm-3 d-none d-sm-inline-block">
                                @Html.LabelFor(x => x.UserName)
                            </div>
                            <div class="col-sm-9">
                                @Html.TextBoxFor(x => x.UserName, new { @class = "form-control", placeholder = @Html.LanguageString("Members.Label.Username") })
                                @Html.ValidationMessageFor(x => x.UserName)
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-sm-3 d-none d-sm-inline-block">
                                @Html.LanguageString("Address.Label.Email")
                            </div>
                            <div class="col-sm-9">
                                @Html.LabelFor(x => x.Email)
                                @Html.TextBoxFor(x => x.Email, new { @class = "form-control", type = "email", placeholder = @Html.LanguageString("Members.Label.EmailAddress") })
                                @Html.ValidationMessageFor(x => x.Email)
                            </div>
                        </div>
                        if (!Model.DisableFileUploads)
                {
                            <div class="row membereditavatar mb-3">
                                <div class="col-3">
                                    <img class="img-circle img-size-64 img-bordered-sm" src="@AppHelpers.MemberImage(Model.Avatar, Model.Email, Model.Id, SiteConstants.Instance.GravatarProfileSize)" alt="@Model.UserName">
                                </div>
                                <div class="col-9">
                                    @Html.LabelFor(x => x.Files)
                                    <div class="input-group">
                                        <span class="input-group-btn">
                                            <span class="btn btn-default btn-sm btn-file">
                                                @Html.LanguageString("Post.Browse") <input type="file" name="files" id="files" value="">
                                            </span>
                                        </span>
                                        <input type="text" class="form-control form-control-sm" readonly="">
                                    </div>
                                    @Html.ValidationMessageFor(x => x.Files)
                                </div>
                            </div>
                        }
                        <div class="row form-group">
                            <div class="col-sm-3  d-none d-sm-inline-block">
                                @Html.LabelFor(x => x.Age)
                            </div>
                            <div class="col-sm-9">
                                @Html.TextBoxFor(x => x.Age, new { @class = "form-control", type = "number", placeholder = @Html.LanguageString("Members.Label.Age") })
                                @Html.ValidationMessageFor(x => x.Age)
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-sm-3 d-none d-sm-inline-block">
                                @Html.LabelFor(x => x.Address)
                            </div>
                            <div class="col-sm-9">
                                @Html.TextBoxFor(x => x.Address, new { @class = "form-control", placeholder = @Html.LanguageString("Members.Label.Address") })
                                @Html.ValidationMessageFor(x => x.Address)
                            </div>
                        </div>
                        if (Model.AmountOfPoints >= settings.PointsAllowedForExtendedProfile)
                {
                            <div class="row form-group">
                                <div class="col-sm-3 d-none d-sm-inline-block">
                                    @Html.LabelFor(x => x.Website)
                                </div>
                                <div class="col-sm-9">
                                    @Html.TextBoxFor(x => x.Website, new { @class = "form-control", placeholder = @Html.LanguageString("Members.Label.Website") })
                                    @Html.ValidationMessageFor(x => x.Website)
                                </div>
                            </div>
                            <div class="row form-group">
                                <div class="col-sm-3 d-none d-sm-inline-block">
                                    @Html.LabelFor(x => x.Twitter)
                                </div>
                                <div class="col-sm-9">
                                    @Html.TextBoxFor(x => x.Twitter, new { @class = "form-control", placeholder = @Html.LanguageString("Members.Label.Twitter") })
                                    @Html.ValidationMessageFor(x => x.Twitter)
                                </div>
                            </div>
                            <div class="row form-group">
                                <div class="col-sm-3 d-none d-sm-inline-block">
                                    @Html.LabelFor(x => x.Facebook)
                                </div>
                                <div class="col-sm-9">
                                    @Html.TextBoxFor(x => x.Facebook, new { @class = "form-control", placeholder = @Html.LanguageString("Members.Label.Facebook") })
                                    @Html.ValidationMessageFor(x => x.Facebook)
                                </div>
                            </div>
                            if (settings.EnableSignatures)
                            {
                                <div class="row form-group">
                                    <div class="col-sm-3 d-none d-sm-inline-block">
                                        @Html.LabelFor(x => x.Signature)
                                    </div>
                                    <div class="col-sm-9">
                                        @Html.TextAreaFor(x => x.Signature, new { @class = "form-control", placeholder = @Html.LanguageString("Members.Label.Signature") })
                                        @Html.ValidationMessageFor(x => x.Signature)
                                    </div>
                                </div>
                            }
                        }
                        <div class="row form-group">
                            <div class="col-9">
                                @Html.LabelFor(m => m.DisableEmailNotifications)
                            </div>
                            <div class="col-3">
                                <div class="form-group">
                                    @Html.CheckBoxFor(m => m.DisableEmailNotifications)
                                </div>
                            </div>
                        </div>
                        <div class="submit-holder">
                            <button type="submit" class="btn btn-outline-success btn-block">@Html.LanguageString("Buttons.Save")</button>
                        </div>
                }
        </div>
    </div>
</section>