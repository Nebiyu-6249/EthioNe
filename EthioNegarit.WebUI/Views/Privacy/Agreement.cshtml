@using System.Web.Mvc.Html
@using EthioNegarit.WebUI.Application.ExtensionMethods
@model EthioNegarit.WebUI.ViewModels.AgreeToTermsAndConditionsViewModel
@{
    Layout = "~/Views/Shared/_LayoutFullWidth.cshtml";
    ViewBag.Title = Html.LanguageString("Privacy.Terms.Title");
}
<script type="text/javascript">
    $.validator.unobtrusive.adapters.addBool("mustbetrue", "required");
</script>
<section class="content">
    <div class="container-fluid">
        <div class="fullscreen flex-container">
            <div class="content-center mt-4">
                <h3>@ViewBag.Title</h3>
                <p>
                    @Html.Settings().ForumName,
                    @Html.LanguageString("Privacy.Terms.Description")
                </p>
                <p>
                    <a href="@Url.Action("Terms", "Privacy")" class="">
                        @Html.LanguageString("Privacy.Terms.Read")
                    </a>
                </p>
                @using (Html.BeginForm("Agreement", "Privacy", FormMethod.Post, new { @class = "form-report" }))
                {
                    @Html.ValidationSummary(true)

                    <div class="checkbox">
                        @using (Html.BeginLabelFor(m => m.Agree, new { @class = "checkbox" }))
                {
                            @Html.CheckBoxFor(m => m.Agree)
                        }
                        @Html.ValidationMessageFor(m => m.Agree)
                    </div>

                    <div class="submit-holder">
                        <button type="submit" class="btn btn-success btn-sm">
                            @Html.LanguageString("Buttons.Continue")
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</section>


















