@model EthioNegarit.WebUI.ViewModels.CreateEditPaymentViewModel

@{
    ViewBag.Title = @Html.LanguageString("Payment.Label.Create");
    Layout = "~/Views/Shared/_LayoutFullWidth.cshtml";
}
<div class="page-header">
            <span class="inline-item-sm">
                @ViewBag.Title
            </span>
    <span class="inline-item-lg float-right">
        <a class="" role="button" href="@Url.Action("List", "Payment")" title="@Html.LanguageString("Payment")">
            @Html.LanguageString("Payment.Label.Back")
        </a>
    </span>
    </div>
<section class="content">
    <div class="container-fluid">
        <div class="fullscreen flex-containerr">               
            @using (Html.BeginForm("Create", "Payment", FormMethod.Post, new { @id = "adpayment", @class = "adpayment" }))
            {
                @Html.ValidationSummary(false)
                @Html.AntiForgeryToken()
                @Html.Partial("_createEditPayment", Model)
            }
            @if (ViewBag.PayPalEnabled != null && (bool)ViewBag.PayPalEnabled)
            {
                <div class="row mb-4">
                    <div class="col-sm-12 text-center">
                        <div class="paypal-divider mb-2">
                            <span>@Html.LanguageString("PayPal.Or")</span>
                        </div>
                        @using (Html.BeginForm("PayPalCheckout", "Payment", FormMethod.Post, new { @id = "paypalform", @class = "paypalform" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="packageId" value="@Model.PackageId" />
                            <input type="hidden" name="advertId" value="@Model.AdvertId" />
                            <input type="hidden" name="month" value="@Model.Month" />
                            <button type="submit" id="paypalbutton" class="btn btn-primary" title="@Html.LanguageString("PayPal.Pay")">
                                <i class="fab fa-paypal mr-1"></i> @Html.LanguageString("PayPal.Pay")
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

