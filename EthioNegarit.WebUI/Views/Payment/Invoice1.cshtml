@using EthioNegarit.WebUI.ViewModels
@model InvoiceViewModel
@{
    ViewBag.Title = "Invoice";
    Layout = "~/Views/Shared/_LayoutFullWidth.cshtml";

    var grossCost = Convert.ToDecimal(@Model.Payment.Month) * Convert.ToDecimal(@Html.Settings().AdCostPerMonth);
    var discount = grossCost * Convert.ToDecimal(@Model.Package.Discount) / 100;
    var totalCost = grossCost - discount;

}
<section class="content">
    <div class="container-fluid">
        <div class="invoice p-3 mb-3">
            <!-- title row -->
            <div class="row">
                <div class="col-12">
                    <h3 class="page-headerr">
                        <i class="fas fa-globe mr-4"></i>
                        <a href="@Html.Settings().ForumUrl">
                            @Html.Raw(Html.Settings().ForumName)
                        </a>

                        <small class="float-right">Date: @DateTime.UtcNow.ToShortDateString()</small>
                    </h3>
                </div>
                <!-- /.col -->
            </div>
            <!-- info row -->
            <div class="row invoice-info">
                <div class="col-sm-4 invoice-col">
                    From
                    <address>
                        <strong>@Html.Raw(Html.Settings().ForumName)</strong><br>
                        @Model.Advertisement.Address<br>
                        San Francisco, CA 94107<br>
                        Phone: @Model.Advertisement.Line<br>
                        Email: @Html.Raw(Html.Settings().NotificationReplyEmail)
                    </address>
                </div>
                <!-- /.col -->
                <div class="col-sm-4 invoice-col">
                    To
                    <address>
                        <strong>@Model.User.UserName</strong><br>
                        @Model.Advertisement.Address<br>
                        San Francisco, CA 94107<br>
                        Phone: @Model.Advertisement.Line<br>
                        Email: @Model.Advertisement.Email
                    </address>
                </div>
                <!-- /.col -->
                <div class="col-sm-4 invoice-col">
                    <b>Invoice # @Model.Payment.Id</b><br>
                    <br>
                    <b>Ad ID:</b>@Model.Advertisement.Id<br>
                    <b>Order ID:</b>@Model.Payment.Id<br>
                    <b>Payment Due:</b>@Model.Payment.DateSubmitted.ToShortDateString()<br>
                    <b>Bank:</b> @Model.Payment.Bank <br>
                    <b>Account:</b> @Model.Payment.AccountNo
                </div>
                <!-- /.col -->
            </div>
            <!-- /.row -->
            <!-- Table row -->
            <div class="row">
                <div class="col-sm-6">
                    <p class="lead">Package</p>
                    <div class="table-responsive">
                        <table class="table">
                            <tr>
                                <th style="width:50%">Package:</th>
                                <td>@Model.Package.Name</td>
                            </tr>
                            <tr>
                                <th>Period</th>
                                <td>@Model.Payment.Month Month</td>
                            </tr>
                            <tr>
                                <th>Start:</th>
                                <td>@Model.Advertisement.DateStart</td>
                            </tr>
                            <tr>
                                <th>End:</th>
                                <td>@Model.Advertisement.DateEnd</td>
                            </tr>
                        </table>
                    </div>

                </div>
                <div class="col-sm-6">
                    <p class="lead">Amount Due 2/22/2014</p>
                    <div class="table-responsive">
                        <table class="table">
                            <tr>
                                <th style="width:50%">Subtotal:</th>
                                <td>$ @grossCost.ToString()</td>
                            </tr>
                            <tr>
                                <th>Discount (@Model.Package.Discount %)</th>
                                <td>$ @discount.ToString()</td>
                            </tr>
                            <tr>
                                <th>Total:</th>
                                <td>$ @totalCost.ToString()</td>
                            </tr>
                        </table>
                    </div>

                </div>

            </div>
            <!-- /.row -->
            <div class="row no-printt">
                <div class="col-sm-6">
                </div>
                <!-- accepted payments column -->
                <div class="col-sm-6">
                    <p class="lead">Payment Methods:</p>
                    <img src="../../Content/images/credit/visa.png" alt="Visa">
                    <img src="../../Content/images/credit/mastercard.png" alt="Mastercard">
                    <img src="../../Content/images/credit/american-express.png" alt="American Express">
                    <img src="../../Content/images/credit/paypal2.png" alt="Paypal">
                    <p class="text-muted well well-sm shadow-none" style="margin-top: 10px;">
                        Etsy doostang zoodles disqus groupon greplin oooj voxy zoodles, weebly ning heekya handango imeem plugg dopplr
                        jibjab, movity jajah plickers sifteo edmodo ifttt zimbra.
                    </p>

                </div>
                <!-- /.col -->
                <!-- /.col -->
            </div>
            <!-- /.row -->
            <div class="row no-print">
                <div class="col-6 mb-5">
                    <a href="#" rel="noopener" target="_blank" class="btn btn-default text-center"><i class="fas fa-print"></i> Print</a>

                </div>
                <div class="col-6 text-center mb-5">
                    <span class="col-6 text-center mb-5">
                        <a class="btn btn-sm float-center" href="@Url.Action("List", "Payment")" title="Cancel and Back">

                            <span class="fas fa-times">
                            </span>
                            Cancel
                        </a>
                    </span>
                    <span class="col-6 text-center mb-5">
                        <a href="#" rel="noopener" target="_blank" class="btn btn-default float-center"><i class="fas fa-print"></i> Print</a>

                    </span>
                </div>
            </div>

        </div>
        <!-- /.content -->
    </div>
</section>
<!-- Page specific script -->
<script>
    window.addEventListener("load", window.print());
</script>
