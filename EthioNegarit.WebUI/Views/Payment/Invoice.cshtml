@using EthioNegarit.WebUI.ViewModels
@model InvoiceViewModel
@{
    ViewBag.Title = @Html.Lang("Payment.Invoice");
    Layout = "~/Views/Shared/_LayoutFullWidth.cshtml";
    var grossPrice = @Model.Payment.TotalPrice + @Model.Payment.Discount;
}
<section class="content">
    <div class="container-fluid">
        <div class="Horizontal-centered no-borderr">
                        <div class="space-6 no-borderr"></div>
                        <div class="row width-75 no-borderr mb-4">
                            <div class="col-sm-12 col-sm-offset-1">
                                <div class="invoice-box transparent no-borderr">
                                    <div class="invoice-header invoice-header-large">
                                        <h3 class="invoice-title grey lighter">
                                            <i class="fas fa-globe mr-4"></i>
                                            <a href="@Html.Settings().ForumUrl">
                                                @Html.Raw(Html.Settings().ForumName)
                                            </a>
                                        </h3>
                                        <div class="invoice-toolbar no-borderr invoice-info">
                                            <span class="invoice-info-label"> @Html.Lang("Payment.InvoiceNo")</span>
                                            <span class="blue-colour"># @Model.Payment.InvoiceNo</span>
                                            <br />
                                            <span class="invoice-info-label">@Html.Lang("Date.Title"):</span>
                                            <span class="blue-colour">@Model.Payment.DateConfirmed.ToShortDateString()</span>
                                           @* <span class="blue-colour">@DateTime.UtcNow.ToShortDateString()</span>*@
                                        </div>
                                        <div class="invoice-toolbar hidden-480">
                                            <a href="#" rel="noopener" target="_blank" class="no-print" title="@Html.LanguageString("Payment.Invoice.Print")">
                                                <i class="ethicon fa fa-print sidebar-light-blue"></i>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="invoice-body transparent">
                                        <div class="invoice-main padding-24">
                                            <div class="row">
                                                <div class="col-sm-6">
                                                    @Html.LanguageString("Text.From")
                                                    <address>
                                                        <strong>@Html.Raw(Html.Settings().ForumName)</strong><br>
                                                        @Model.Advertisement.Address Street, City<br>
                                                        San Francisco, CA 94107 State, Country<br>
                                                        Phone: @Model.Advertisement.Line<br>
                                                        Email: @Html.Raw(Html.Settings().NotificationReplyEmail)
                                                    </address>
                                                </div><!-- /.col -->

                                                <div class="col-sm-6">
                                                    @Html.LanguageString("Text.To")
                                                    <address>
                                                        <strong>@Model.User.UserName</strong><br>
                                                        @Model.Advertisement.Address<br>
                                                        San Francisco, CA 94107 State, Country<br>
                                                        Phone: @Model.Advertisement.Line<br>
                                                        Email: @Model.Advertisement.Email <br>
                                                        <b>Payment Due:</b>@Model.Payment.DateSubmitted.ToShortDateString()<br>
                                                        <b>Bank:</b> @Model.Payment.Bank <br>
                                                        <b>Account:</b> @Model.Payment.AccountNo
                                                    </address>
                                                </div><!-- /.col -->
                                            </div><!-- /.row -->
                                            <div class="space"></div>
                                            <div>
                                                <table class="table table-striped table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th class="center">#</th>
                                                            <th>@Html.LanguageString("Package.Name")</th>
                                                            <th class="hidden-xs">@Html.LanguageString("Text.Description")</th>
                                                            <th class="hidden-480">@Html.LanguageString("Payment.Label.Discount")</th>
                                                            <th>@Html.LanguageString("Payment.Label.TotalPrice")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td class="center">1</td>
                                                            <td>
                                                                <a href="#">
                                                                    @Html.Raw(Model.Package.DisplayName)
                                                                </a>
                                                            </td>
                                                            <td class="hidden-xs">
                                                                @Html.Raw(string.Format(Html.LanguageString("Payment.Description"), @Model.Payment.Month))
                                                            </td>
                                                            <td class="hidden-480"> @Model.Package.Discount % </td>
                                                            <td>$ @Model.Payment.TotalPrice.ToString()</td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <p class="lead">@Html.Lang("Text.ExtraInfo")</p>
                                                    <div class="table-responsive">
                                                        <table class="table">
                                                            <tr>
                                                                <th>@Html.LanguageString("Package.Name")</th>
                                                                <td>@Html.Raw(Model.Package.DisplayName)</td>
                                                            </tr>
                                                            <tr>
                                                                <th>@Html.Lang("Text.Description")</th>
                                                                <td>@Html.Raw(string.Format(Html.LanguageString("Payment.Description"), @Model.Payment.Month))</td>
                                                            </tr>
                                                            @*    <tr>
                                <th>@Html.Lang("Payment.Duration")</th>
                                <td>@Model.Payment.Month @Html.LanguageString("Payment.Label.Month")</td>
                            </tr>*@
                                                            <tr>
                                                                <th>@Html.Lang("Date.StartDate")</th>
                                                                <td>@Model.Advertisement.DateStart.ToShortDateString()</td>
                                                            </tr>
                                                            <tr>
                                                                <th>@Html.Lang("Date.EndDate")</th>
                                                                <td>@Model.Advertisement.DateEnd.ToShortDateString()</td>
                                                            </tr>
                                                        </table>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <p class="lead"> @Html.Lang("Text.Summary")</p>
                                                    <div class="table-responsive">
                                                        <table class="table">
                                                            <tr>
                                                                <th></th>
                                                                <td></td>
                                                            </tr>
                                                            <tr>
                                                                <th></th>
                                                                <td></td>
                                                            </tr>
                                                            <tr>
                                                                <th style="width:50%">@Html.LanguageString("Payment.Label.GrossPrice")</th>
                                                                <td>$ @grossPrice.ToString()</td>
                                                            </tr>
                                                            <tr>
                                                                <th>@Html.LanguageString("Payment.Label.Discount") (@Model.Package.Discount %)</th>
                                                                <td>$ @Model.Payment.Discount.ToString()</td>
                                                            </tr>

                                                            <tr>
                                                                <th><h5 class="red-colourr">@Html.LanguageString("Payment.Label.TotalPrice")</h5></th>
                                                                <td><h5 class="red-colour">$ @Model.Payment.TotalPrice.ToString()</h5></td>
                                                            </tr>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="hr hr8 hr-double hr-dotted"></div>
                                            @*   <div class="row">
                <div class="col-sm-7 pull-leftt"></div>
                <div class="col-sm-5 float-right">
                    <h4 class="float-right">
                        @Html.LanguageString("Payment.Label.TotalPrice")
                        <span class="red-colour">$ @Model.Payment.TotalPrice.ToString()</span>
                    </h4>
                </div>
            </div>*@
                                            <div class="space-6"></div>
                                            <div class="well float-right">
                                                @Html.Lang("Payment.Invoice.Footer")
                                            </div>
                                        </div>
                                            <div class="hr hr8 hr-double hr-dotted"></div>                 
                                    </div>
                                </div>
                            </div>
                        </div>                
            </div><!-- /.row -->
        </div>

</section>
<!-- Page specific script -->
<script>
        window.addEventListener("load", window.print());
    </script>