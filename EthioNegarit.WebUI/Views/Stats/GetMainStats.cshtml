@model EthioNegarit.WebUI.ViewModels.MainStatsViewModel
    <div class="box info-box">
        <a href="@Url.Action("Index", "Topic")">
            <div class="box-header">
                <h5 class="text-smm text-center text-boldd">@Html.LanguageString("About.Discussions")</h5>
            </div>
            <div class="box-body">
                    @Html.Raw(string.Format(Html.LanguageString("Stats.FooterMainStatText"), Model.MemberCount, Model.PostCount, Model.TopicCount))
            </div>
        </a>
</div>
<div class="box info-box">
    <a href="@Url.Action("Index", "Category")">
        <div class="box-header">
            <h5 class="text-smm text-center text-boldd">@Html.LanguageString("Layout.Nav.Categories") </h5>
        </div>
            <div class="box-body">
          @(string.Format(Html.LanguageString("About.CategoriesText"), Model.CategoryCount, Model.TopicCount))
            </div>      
    </a>
</div>
<div class="box info-box">
    <a href="@Url.Action("Search","Members")" class="">
        <div class="box-header">
            <h5 class="text-smm text-center text-boldd">@Html.LanguageString("SubNav.Members")</h5>
        </div>
            <div class="box-body">
               @(string.Format(Html.LanguageString("About.MembersText"), @Model.MemberCount))          
            </div>      
    </a>
</div>



















