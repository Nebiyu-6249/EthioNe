@model EthioNegarit.Core.Domain.Entities.Badge
@{
    Layout = null;

}
<div class="box">
    <div class="badge-header">
        <span class="image">
            <img src="@Url.Content(AppHelpers.ReturnBadgeUrl(Model.Image))" class="img-size-32 img-circle elevation-3" alt="@Model.Name" />
        </span>
        <span class="badge-name" title="@Model.DisplayName">
        @Html.Raw(Model.DisplayName)
    </span>
       @* <div class="badge-info badge-name">
        <p class="publicbadgename">@Html.Raw(Model.DisplayName)</p>
    </div>*@
    </div>
        <div class="box-body content-text text-sm text-muted float-center">
            <div class="badge-award text-muted float-center">
                @if (Model.AwardsPoints != null && Model.AwardsPoints > 0)
                {
                    <p class="publicbadgeawards">@(string.Format(Html.LanguageString("Badges.AwardsPoints"), Model.AwardsPoints))</p>}
            </div>
            <div class="text-sm text-muted float-center">
                @Model.Description
            </div>
            </div>
    </div>