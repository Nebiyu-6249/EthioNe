@model  EthioNegarit.WebUI.ViewModels.SubCategoryViewModel
<div class="subcategory  clearfix">
    @* <h4>@Html.Raw(string.Concat(Html.LanguageString("Category.SubCategoriesHeading"), " ", Model.ParentCategory.Name))</h4>*@
    <ol class="breadcrumb text-sm float-right">
        @foreach (var category in Model.AllPermissionSets.Keys)
            {
                var permissions = Model.AllPermissionSets[category];
                if (!permissions[SiteConstants.Instance.PermissionDenyAccess].IsTicked)
                {
                <li class="breadcrumb-item">
                    <a style="border-color: @(string.IsNullOrEmpty(category.Colour) ? " #ced1d1" : category.Colour)" href="@Html.Raw(category.NiceUrl)">@Html.Raw(@category.Name)</a>
                </li>
            }
        }
    </ol>
</div>
