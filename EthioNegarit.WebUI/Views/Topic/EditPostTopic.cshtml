
@model EthioNegarit.WebUI.ViewModels.CreateEditTopicViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Html.LanguageString("Post.Edit");
}
@section Header
{
    @(
 SquishIt.Framework.Bundle.JavaScript()
            .Add("~/Scripts/jquery.tagsinput.min.js")
            .Add("~/Scripts/tags.js")
            .Add("~/Scripts/createtopic.js")
            .MvcRender("~/scripts/cache/topic-combined_#.js")
    )
    <script type="text/javascript">
        counter = @(Model.PollAnswers != null ? Model.PollAnswers.Count : 0);
    </script>
}
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <div class="editpostholder">
                    @using (Html.BeginForm())
            {
                        @Html.ValidationSummary(false)
                        @Html.AntiForgeryToken()
                        @Html.Partial("_CreateEdit_TopicPost", Model)
                        @Html.HiddenFor(x => x.Id)
                    }
                </div>
            </div>
        </div>
    </div>
</section>