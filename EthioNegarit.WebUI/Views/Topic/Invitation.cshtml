@using EthioNegarit.WebUI.ViewModels
@model TopicInvitationViewModel
    @{ 
        var count = 0;
    }
<div class="content-header">
    <div class="content-body">
        <div class="title">
            <a href="@Html.Raw(Model.Topic.NiceUrl)">
                @Html.Raw(Model.Topic.Name)
            </a>
        </div>
        <div class="inline">
            @Html.Action("GetTopicBreadcrumb", "Topic", new { topic = Model.Topic })
        </div>
        <div class="container-fluid clearfix">
            <div class="postcontent content-text">
                <p>@Html.Raw(AppHelpers.ConvertPostContent(Model.StartPost.PostContent))</p>
            </div>
        </div>
    </div>
</div>
<p>@Html.LanguageString("Topic.Invitation")</p>
@using (Html.BeginForm("Invitation", "Topic", FormMethod.Post))
{
    @Html.HiddenFor(x => x.TopicId)
    //  @Html.ValidationSummary(false)
    //   @Html.AntiForgeryToken()

    <div id="invitationsContainer">
        <div class="invitation">
@*@if (Model.InvitationTo != null && Model.InvitationTo.Any())
    {*@
      @for (int i = 0; i < Model.InvitationTo.Count; i++)
    {
                    <div class="row">
                        <div class="col-sm-1">
                         @Html.LanguageString("Text.To")             
                        </div>
                        <div class="col-sm-5">
                            <div class="form-group" id="Name">
                                @*   <input type="text" name="InvitationTo[@(i)].Name" id="InvitationTo_@(count)_Name" value="" class="form-control" placeholder="@Html.LanguageString("Topic.Invitation.Name")" />*@
                                <input type="text" name="InvitationTo[@(i)].Name" value="" class="form-control" placeholder="@Html.LanguageString("Topic.Invitation.Name")" />
                            </div>
                        </div>
                        <div class="col-sm-5">
                            <div class="form-group" id="Email">
                                @*   <input type="email" name="InvitationTo[@(i)].Email" id="InvitationTo_@(count)_Email" value="" class="form-control" placeholder="@Html.LanguageString("Topic.Invitation.Email")" />*@
                                <input type="email" name="InvitationTo[@(i)].Email" value="" class="form-control" placeholder="@Html.LanguageString("Topic.Invitation.Email")" />
                            </div>
                        </div>
                        @if (i > 1)
                        {
                            <a href="#" class="btn btn-mvc removeinvetation">
                                <span class="fas fa-minus" aria-hidden="true"></span>
                            </a>
                        }
                    </div>
                 
}
        </div>
    </div>
    <div class="submit-holder">
        <div class="row">
            <div class="col-6">
                <button type="button" id="addInvitation" class="btn btn-sm btn-success btn-block" title="@Html.LanguageString("Buttons.AddGuest")">
                    @Html.LanguageString("Buttons.AddGuest")
                </button>
            </div>
            <div class="col-6">
                <button type="submit" class="btn btn-sm btn-success btn-block" title="@Html.LanguageString("Buttons.SendInvitation")">
                    @Html.LanguageString("Buttons.SendInvitation")
                </button>
            </div>
        </div>             
    </div>
}
<div id="validationSummary" class="validation-summary">
    <ul></ul>
</div>
<script>
    $(document).on("click", ".removeinvetation", function () {
        var thisLink = $(this);
      var id = thisLink.data("id");
      $("#invitationTo_" + id).remove();
        //  var invitationHolder = $("#invitationsContainer .invitation").closest($("#invitationTo_" + id));
        //   invitationHolder.remove();
        //  invitationHolder.hide();
    });
    $("#addInvitation").click(function () {
        var index = $("#invitationsContainer .invitation").length;
        var html = `
      <div class ="invitation">
      <div class ="row" id="invitationTo_${index}">
      <div class ="col-1"><label>@Html.LanguageString("Text.To")</label></div>
       <div class ="col-5"><input type="text" name="InvitationTo[${index}].Name" class="form-control" placeholder="@Html.LanguageString("Topic.Invitation.Name")" /></div>
       <div class ="col-5"><input type="email" name="InvitationTo[${index}].Email" class ="form-control" placeholder="@Html.LanguageString("Topic.Invitation.Email")" /></div>
       <div class ="col-1"><a href="#" class ="btn btn-sm removeinvetation" data-id="[${index}]"><span class ="fas fa-minus" aria-hidden="true"></span></a></div>
      </div>
      </div>`;
        $("#invitationsContainer").append(html);
    });
    //}
</script>
@* <div class ="col-1"><label>@Html.LanguageString("Text.To") ${index}</label></div>*@
