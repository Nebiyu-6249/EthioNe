@model EthioNegarit.WebUI.Areas.Admin.ViewModels.HelpViewModel

@{
    ViewBag.Title = "Create Support";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@Html.Partial("_HelpNavButtons")

<div class="panel">
    <div class="panel-heading">
        <h5>@ViewBag.Title</h5>
    </div>
    <div class="panel-content">
        @using (Html.BeginForm("CreateSupport", "AdminHelp", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.ValidationSummary(false)
            @Html.AntiForgeryToken()

            @Html.Partial("_HelpFields", Model)

            <div class="submit-holder">
                <input type="submit" class="btn btn-mvc-green btn-mvc-large" value="Create" />
            </div>
        }
    </div>
</div>
