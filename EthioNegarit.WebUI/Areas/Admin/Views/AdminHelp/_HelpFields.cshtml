@model EthioNegarit.WebUI.Areas.Admin.ViewModels.CreateEditFAQViewModel

<div class="form-group">
    @Html.LabelFor(model => model.Language)
    @Html.DropDownListFor(model => model.Language, Model.Languages, new { @class = "form-control" })
    @Html.ValidationMessageFor(model => model.Language)
</div>
<div class="form-group">
    @Html.LabelFor(model => model.Question)
    @Html.TextBoxFor(model => model.Question, new { @class = "form-control" })
    @Html.ValidationMessageFor(model => model.Question)
</div>
<div class="form-group">
    @Html.LabelFor(model => model.Replay)
    @Html.EditorFor(model => model.Replay)
    @Html.ValidationMessageFor(model => model.Replay)
</div>

