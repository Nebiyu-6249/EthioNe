@using EthioNegarit.Utilities
@model EthioNegarit.WebUI.Areas.Admin.ViewModels.IndexViewModel
@{

    ViewBag.Title = "Ethiopical Admin";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

}
@section AdminHeader
{
    <script src="@Url.Content("~/Scripts/dashboard.js")" type="text/javascript"></script>
}
<section class="content">
    <div class="container-fluid">
        <div class="row dashboardrow">
            <div class="col-md-6">
                <div class="admindashboard">
                    <div class="dashboardtodaystopics">
                        <img src="@Url.Content("~/Content/Images/arrow-spinner-blue.gif")" alt="loading" />
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="admindashboard">
                    <div class="dashboardlowestpointposts">
                        <img src="@Url.Content("~/Content/Images/arrow-spinner-blue.gif")" alt="loading" />
                    </div>
                </div>
            </div>
        </div>
        <div class="row dashboardrow">
            <div class="col-md-6">
                <div class="admindashboard">
                    <div class="dashboardlatestusers">
                        <img src="@Url.Content("~/Content/Images/arrow-spinner-blue.gif")" alt="loading" />
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="admindashboard">
                    <div class="dashboardlowestpointusers">
                        <img src="@Url.Content("~/Content/Images/arrow-spinner-blue.gif")" alt="loading" />
                    </div>
                </div>
            </div>
        </div>
        <div class="row dashboardrow">
            <div class="col-md-6">
                <div class="admindashboard">
                    <div class="dashboardhighestviewedtopics">
                        <img src="@Url.Content("~/Content/Images/arrow-spinner-blue.gif")" alt="loading" />
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="admindashboard">
                    <div class="dashboardrecenttopics">
                        <img src="@Url.Content("~/Content/Images/arrow-spinner-blue.gif")" alt="loading" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
