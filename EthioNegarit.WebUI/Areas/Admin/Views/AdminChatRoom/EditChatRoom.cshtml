@model EthioNegarit.WebUI.Areas.Admin.ViewModels.ChatRoomViewModel

@{
    ViewBag.Title = "Edit ChatRoom";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@Html.Partial("_ChatRoomNavButtons")

<div class="panel">
    <div class="panel-heading">
        <h5>@ViewBag.Title</h5>
    </div>
    <div class="panel-content">
        @using (Html.BeginForm("EditChatRoom", "AdminChatRoom", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.ValidationSummary(false)
            @Html.HiddenFor(model => model.Id)

            @Html.Partial("_ChatRoomFields", Model)

            <div class="submit-holder">
                <input type="submit" class="btn btn-mvc-green btn-mvc-large" value="Update" />
                <a href="@Url.Action("DeleteChatRoomConfirmation", new { id = Model.Id })" class="btn btn-mvc btn-mvc-large" role="button">Delete</a>
            </div>
        }

    </div>
</div>

