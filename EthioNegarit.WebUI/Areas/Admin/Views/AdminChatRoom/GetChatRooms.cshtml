@using EthioNegarit.Core.Domain.Entities
@model EthioNegarit.WebUI.Areas.Admin.ViewModels.ListChatRoomsViewModel
@{
    var chatRooms = Model.ChatRooms.ToList();
}

<div class="panel">
    <div class="panel-heading">
        <h5>All ChatRoom</h5>
    </div>
    <div class="panel-content">
        <div id="container">
            <ul>
                @foreach (var room in chatRooms)
                {
                    <li class="maincategory">
                        <a href="@Url.Action("EditChatRoom", new { id = room.Id })">
                            @Html.Raw(room.Name)
                        </a>
                     
                    </li>
                }

            </ul>
        </div>
    </div>
</div>


