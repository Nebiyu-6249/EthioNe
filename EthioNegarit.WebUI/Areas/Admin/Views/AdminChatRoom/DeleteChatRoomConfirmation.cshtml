@model EthioNegarit.WebUI.Areas.Admin.ViewModels.DeleteChatRoomViewModel
@{
    ViewBag.Title = "Delete ChatRoom";
    var topicCount = Model.Category.Topics.Count;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@Html.Partial("_ChatRoomNavButtons")

<div class="panel">
    <div class="panel-heading">
        <h5>@ViewBag.Title</h5>
    </div>
    <div class="panel-content">
       
        @if (Model.Category.Topics.Any())
        {
            <h2>Unable To Delete</h2>
            <p>This category has discussions associated with it, please either delete or move the topics to a different category</p>

            <h4>Topics</h4>
            <ul>
                @foreach (var topic in Model.Category.Topics.Take(10))
                {
                    <li><a href="@topic.NiceUrl">@topic.Title</a></li>
                }
            </ul>
            if (topicCount > 10)
            {
                <p>And @(topicCount - 10) other topics...</p>
            }
            <a href="@Url.Action("Index")" class="btn btn-mvc btn-mvc-large">Back</a>
        }
        else
        {
            using (Html.BeginForm("DeleteChatRoom", "ChatRoom", FormMethod.Post))
            {
                <h2>Delete ChatRoom?</h2>
                <p>Are you sure you want to delete this ChatRoom? You cannot undo this action.</p>
                @Html.HiddenFor(x => x.Id)
                <div class="submit-holder">
                    <input type="submit" class="btn btn-mvc btn-mvc-large" value="Yes" />
                </div>
            }
        }
    </div>
</div>

