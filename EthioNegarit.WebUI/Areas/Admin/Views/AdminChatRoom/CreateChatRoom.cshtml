@model EthioNegarit.WebUI.Areas.Admin.ViewModels.ChatRoomViewModel
@{
    ViewBag.Title = "Create ChatRoom";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@Html.Partial("_ChatRoomNavButtons")

<div class="panel">
    <div class="panel-heading">
        <h5>@ViewBag.Title</h5>
    </div>
    <div class="panel-content">
        @using (Html.BeginForm("CreateChatRoom", "AdminChatRoom", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.ValidationSummary(false)
            @Html.AntiForgeryToken()

            @Html.Partial("_ChatRoomFields", Model)

            <div class="submit-holder">
                <input type="submit" class="btn btn-mvc-green btn-mvc-large" value="Create" />
            </div>
        }
    </div>
</div>

